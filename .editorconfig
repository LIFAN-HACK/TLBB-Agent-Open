root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,sln,xaml,props,targets,ps1,bat,cmd}]
end_of_line = crlf

[*.cs]
indent_style = space
indent_size = 4

[*.{json,jsonl,yaml,yml,html,css,js,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
