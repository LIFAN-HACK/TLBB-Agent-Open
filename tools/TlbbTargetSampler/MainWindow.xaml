<Window x:Class="TlbbTargetSampler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TLBB Agent 目标采集器" Height="760" Width="1180"
        MinHeight="680" MinWidth="1040"
        Background="#0B0F16" Foreground="#EAF2FF"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#141A24"/>
        <SolidColorBrush x:Key="Panel2Brush" Color="#101620"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#2C3748"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4D86FF"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F7FAFF"/>
            <Setter Property="Background" Value="#202938"/>
            <Setter Property="BorderBrush" Value="#38465C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F7FAFF"/>
            <Setter Property="Background" Value="#090E15"/>
            <Setter Property="BorderBrush" Value="#344258"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D9E7FF"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111720" BorderBrush="#2C3748" BorderThickness="0,0,0,1">
            <DockPanel Margin="18,0">
                <TextBlock Text="TLBB Agent 目标采集器" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="只采集截图，不控制游戏" Foreground="#8CA0BD" Margin="16,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="SaveRootText" DockPanel.Dock="Right" Foreground="#8CA0BD" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Padding="14" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="1. 绑定窗口" FontWeight="Bold" FontSize="15"/>
                        <Border x:Name="DragBindBox"
                                Margin="0,12,0,10"
                                Height="96"
                                Background="#0B1018"
                                BorderBrush="#3B4A63"
                                BorderThickness="1"
                                CornerRadius="8"
                                MouseLeftButtonDown="DragBindBox_MouseLeftButtonDown"
                                MouseLeftButtonUp="DragBindBox_MouseLeftButtonUp">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="按住拖到游戏窗口后松开" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock Text="或使用下面的自动绑定" HorizontalAlignment="Center" Foreground="#8CA0BD" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Button Content="自动绑定 Game.exe" Click="AutoBind_Click"/>
                        <TextBlock Text="当前绑定" Foreground="#8CA0BD" Margin="0,16,0,6"/>
                        <Border Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Padding="10" CornerRadius="6">
                            <StackPanel>
                                <TextBlock x:Name="WindowTitleText" Text="未绑定" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="WindowInfoText" Text="-" Foreground="#8CA0BD" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="WindowPathText" Text="-" Foreground="#8CA0BD" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Padding="14" CornerRadius="8" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="2. 采集样本" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="先在游戏里选中目标，再点击采集。无目标样本需要保证目标面板为空。" Foreground="#8CA0BD" Margin="0,8,0,12" TextWrapping="Wrap"/>
                        <Button Content="采集当前画面" Background="{StaticResource AccentBrush}" Click="Capture_Click"/>
                        <Button Content="刷新预览" Margin="0,10,0,0" Click="RefreshPreview_Click"/>
                        <Button Content="打开样本目录" Margin="0,10,0,0" Click="OpenSampleRoot_Click"/>
                        <TextBlock x:Name="LastSavedText" Text="尚未采集" Foreground="#8CA0BD" Margin="0,14,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="CoverageText" Text="样本覆盖：未检查" Foreground="#AFC0DA" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="NextSampleText" Text="下一份建议：-" Foreground="#FFD27A" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Padding="14" CornerRadius="8" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="目标区微调" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="只移动目标名字、血条、门派竖牌、头像等目标面板区域。按住 Shift 每次移动 5 像素。" Foreground="#8CA0BD" Margin="0,8,0,10" TextWrapping="Wrap"/>
                        <UniformGrid Columns="3" Rows="3">
                            <Border/>
                            <Button Content="上" Tag="up" Click="Nudge_Click" Margin="3"/>
                            <Border/>
                            <Button Content="左" Tag="left" Click="Nudge_Click" Margin="3"/>
                            <Button Content="重置" Tag="reset" Click="Nudge_Click" Margin="3"/>
                            <Button Content="右" Tag="right" Click="Nudge_Click" Margin="3"/>
                            <Border/>
                            <Button Content="下" Tag="down" Click="Nudge_Click" Margin="3"/>
                            <Border/>
                        </UniformGrid>
                        <TextBlock x:Name="OffsetText" Text="偏移：X 0 / Y 0" Foreground="#AFC0DA" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Padding="14" CornerRadius="8" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="宠物出战点标定" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="在右侧预览图中点击“当前宠物出战”按钮中心。只保存配置，不点击游戏。" Foreground="#8CA0BD" Margin="0,8,0,10" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="方案" VerticalAlignment="Center" Foreground="#AFC0DA"/>
                            <TextBox x:Name="PetDeployProfileText" Grid.Column="1" Height="32" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Button x:Name="PetDeployPickButton" Content="开始在预览图点选" Margin="0,10,0,0" Click="PetDeployPick_Click"/>
                        <Button Content="保存宠物出战点击点" Margin="0,10,0,0" Background="{StaticResource AccentBrush}" Click="SavePetDeployPoint_Click"/>
                        <TextBlock x:Name="PetDeployPointText" Text="未选择" Foreground="#FFD27A" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Padding="14" CornerRadius="8" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="保存内容" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="client.png：完整客户区截图" Foreground="#AFC0DA" Margin="0,8,0,0"/>
                        <TextBlock Text="overlay.png：区域框预览，不写文字到画面" Foreground="#AFC0DA" Margin="0,4,0,0"/>
                        <TextBlock Text="crops：目标血蓝怒、门派竖牌、头像等裁剪图" Foreground="#AFC0DA" Margin="0,4,0,0"/>
                        <TextBlock Text="metadata.json：窗口、标注、偏移、裁剪区域" Foreground="#AFC0DA" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Text="窗口预览 / 采集区域" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PreviewInfoText" DockPanel.Dock="Right" Foreground="#8CA0BD" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,16,0">
                            <Button Content="1x" Tag="1" Click="Zoom_Click" MinWidth="44" Padding="8,5" Margin="0,0,6,0"/>
                            <Button Content="2x" Tag="2" Click="Zoom_Click" MinWidth="44" Padding="8,5" Margin="0,0,6,0"/>
                            <Button Content="4x" Tag="4" Click="Zoom_Click" MinWidth="44" Padding="8,5" Margin="0,0,6,0"/>
                            <Button Content="8x" Tag="8" Click="Zoom_Click" MinWidth="44" Padding="8,5"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Margin="0,12,0,0" Background="#05080D" BorderBrush="#253044" BorderThickness="1">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Image x:Name="PreviewImage" Stretch="None" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor" MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown">
                                <Image.LayoutTransform>
                                    <ScaleTransform x:Name="PreviewScaleTransform" ScaleX="1" ScaleY="1"/>
                                </Image.LayoutTransform>
                            </Image>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#080D14" BorderBrush="#2C3748" BorderThickness="0,1,0,0" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="日志" FontWeight="Bold"/>
                <ListBox x:Name="LogList"
                         Grid.Row="1"
                         Margin="0,8,0,0"
                         Background="#080D14"
                         BorderThickness="0"
                         Foreground="#DDE8FA"/>
            </Grid>
        </Border>
    </Grid>
</Window>
