<Window x:Class="TlbbTargetSampler.LabelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入采集标注"
        Height="405"
        Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0B0F16"
        Foreground="#EAF2FF"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F7FAFF"/>
            <Setter Property="Background" Value="#202938"/>
            <Setter Property="BorderBrush" Value="#38465C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F7FAFF"/>
            <Setter Property="Background" Value="#090E15"/>
            <Setter Property="BorderBrush" Value="#344258"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F7FAFF"/>
            <Setter Property="Background" Value="#090E15"/>
            <Setter Property="BorderBrush" Value="#344258"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D9E7FF"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="确认这次采集的真实目标" FontWeight="Bold" FontSize="16"/>
        <TextBlock x:Name="MissingTextBlock"
                   Grid.Row="1"
                   Margin="0,8,0,12"
                   Foreground="#8CA0BD"
                   TextWrapping="Wrap"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="目标类型" VerticalAlignment="Center"/>
            <ComboBox x:Name="KindComboBox"
                      Grid.Column="1"
                      Height="36"
                      SelectedIndex="0"
                      SelectionChanged="KindComboBox_SelectionChanged">
                <ComboBoxItem Content="未知 / 待复核" Tag="unknown"/>
                <ComboBoxItem Content="玩家目标" Tag="player"/>
                <ComboBoxItem Content="普通怪物" Tag="monster"/>
                <ComboBoxItem Content="首领 / BOSS" Tag="boss"/>
                <ComboBoxItem Content="宠物 / 宝宝" Tag="pet"/>
                <ComboBoxItem Content="无目标" Tag="none"/>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="快捷选择" VerticalAlignment="Center"/>
            <WrapPanel Grid.Column="1">
                <Button Content="玩家" Tag="player" MinWidth="68" Padding="10,6" Margin="0,0,8,8" Click="QuickKind_Click"/>
                <Button Content="普通怪" Tag="monster" MinWidth="68" Padding="10,6" Margin="0,0,8,8" Click="QuickKind_Click"/>
                <Button Content="BOSS" Tag="boss" MinWidth="68" Padding="10,6" Margin="0,0,8,8" Click="QuickKind_Click"/>
                <Button Content="宠物" Tag="pet" MinWidth="68" Padding="10,6" Margin="0,0,8,8" Click="QuickKind_Click"/>
                <Button Content="无目标" Tag="none" MinWidth="68" Padding="10,6" Margin="0,0,8,8" Click="QuickKind_Click"/>
            </WrapPanel>
        </Grid>

        <Border Grid.Row="4"
                Margin="0,12,0,0"
                Padding="10"
                CornerRadius="6"
                Background="#121A27"
                BorderBrush="#2C3748"
                BorderThickness="1">
            <TextBlock x:Name="KindHintTextBlock" TextWrapping="Wrap" Foreground="#AFC0DA"/>
        </Border>

        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="采集标注" VerticalAlignment="Center"/>
            <TextBox x:Name="LabelTextBox"
                     Grid.Column="1"
                     Height="38"
                     VerticalContentAlignment="Center"
                     KeyDown="LabelTextBox_KeyDown"/>
        </Grid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Click="Cancel_Click"/>
            <Button Content="保存" Margin="10,0,0,0" Background="#4D86FF" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
