<UserControl x:Class="TlbbAgent.App.Views.GuildContributionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TlbbAgent.App.Controls"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel MaxWidth="1120" HorizontalAlignment="Left">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="载入流程" Style="{StaticResource GhostButton}" Width="82" Height="32" Margin="0,0,8,0" Command="{Binding ImportPlanCommand}" />
                    <Button Content="保存" Style="{StaticResource GhostButton}" Width="62" Height="32" Margin="0,0,8,0" Command="{Binding SaveCommand}" />
                    <Button Content="加载" Style="{StaticResource PrimaryButton}" Width="62" Height="32" Command="{Binding LoadCommand}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Label}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{Binding IsReady, Converter={StaticResource BoolToStableBg}}">
                            <TextBlock Text="{Binding ReadySummary}" FontSize="10.5" Foreground="{StaticResource Text.SecondaryBrush}" />
                        </Border>
                        <TextBlock Text="摘要" Style="{StaticResource H2}" />
                    </DockPanel>
                    <UniformGrid Columns="2" Margin="0,12,0,0">
                        <StackPanel Margin="0,0,14,10">
                            <TextBlock Text="流程" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding PlanSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="执行" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding RunSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,10">
                            <TextBlock Text="节奏" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding TimingSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="清包" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding CleanupSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="物品" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding ItemSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="#22222A35">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding RunState, Converter={StaticResource RunStateBrush}}" />
                                <TextBlock Text="{Binding CurrentStateName}" FontSize="10.5" Margin="6,0,0,0" Foreground="{StaticResource Text.SecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="设置" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding PlanSummary}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <WrapPanel Margin="0,14,0,0">
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="配置名" Style="{StaticResource Caption}" /><TextBox Width="136" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="流程名" Style="{StaticResource Caption}" /><TextBox Width="136" Text="{Binding PlanName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="轮次" Style="{StaticResource Caption}" /><TextBox Width="64" Text="{Binding RoundCount, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="到点距离" Style="{StaticResource Caption}" /><TextBox Width="72" Text="{Binding ArrivalDistance, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="步骤间隔" Style="{StaticResource Caption}" /><TextBox Width="84" Text="{Binding StepIntervalMs, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="动作间隔" Style="{StaticResource Caption}" /><TextBox Width="84" Text="{Binding ActionIntervalMs, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="重试" Style="{StaticResource Caption}" /><TextBox Width="60" Text="{Binding MaxStepRetry, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="执行方式" Style="{StaticResource Caption}" />
                            <ComboBox Width="128" ItemsSource="{Binding ExecutionModes}" SelectedItem="{Binding ExecutionMode}">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource GuildContributionExecutionModeText}}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="发送" Style="{StaticResource Caption}" />
                            <ComboBox Width="132" ItemsSource="{Binding DispatchModes}" SelectedItem="{Binding DispatchMode}">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource DispatchModeText}}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>

                    <WrapPanel Margin="0,2,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,10"><CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LoopPlan}" Margin="0,0,8,0" /><TextBlock Text="循环流程" Style="{StaticResource Label}" VerticalAlignment="Center" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,10"><CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StopAfterRounds}" Margin="0,0,8,0" /><TextBlock Text="轮次后停止" Style="{StaticResource Label}" VerticalAlignment="Center" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,10"><CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding EnableCleanupAfterTask}" Margin="0,0,8,0" /><TextBlock Text="任务后清包" Style="{StaticResource Label}" VerticalAlignment="Center" /></StackPanel>
                        <StackPanel Margin="0,0,18,10"><TextBlock Text="任务热键" Style="{StaticResource Caption}" /><controls:HotkeyRecorder Width="110" Height="34" Hotkey="{Binding OpenTaskHotkey, Mode=TwoWay}" /></StackPanel>
                        <StackPanel Margin="0,0,0,10"><TextBlock Text="清包热键" Style="{StaticResource Caption}" /><controls:HotkeyRecorder Width="110" Height="34" Hotkey="{Binding CleanupHotkey, Mode=TwoWay}" /></StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="任务类型" Style="{StaticResource H2}" />
                        <ItemsControl ItemsSource="{Binding TaskTypes}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="68" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,8,0" />
                                        <TextBox Grid.Column="2" Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="添加步骤" Style="{StaticResource H2}" Margin="0,14,0,0" />
                        <WrapPanel Margin="0,12,0,0">
                            <StackPanel Margin="0,0,12,10"><TextBlock Text="类型" Style="{StaticResource Caption}" /><ComboBox Width="110" ItemsSource="{Binding TaskTypeNames}" SelectedItem="{Binding NewTaskType}" /></StackPanel>
                            <StackPanel Margin="0,0,12,10"><TextBlock Text="动作" Style="{StaticResource Caption}" /><ComboBox Width="110" ItemsSource="{Binding Actions}" SelectedItem="{Binding NewAction}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource GuildContributionStepActionText}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                            <StackPanel Margin="0,0,12,10"><TextBlock Text="地图" Style="{StaticResource Caption}" /><TextBox Width="110" Text="{Binding NewMapName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Margin="0,0,12,10"><TextBlock Text="X" Style="{StaticResource Caption}" /><TextBox Width="58" Text="{Binding NewX, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Margin="0,0,12,10"><TextBlock Text="Y" Style="{StaticResource Caption}" /><TextBox Width="58" Text="{Binding NewY, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Margin="0,0,12,10"><TextBlock Text="NPC" Style="{StaticResource Caption}" /><TextBox Width="104" Text="{Binding NewNpcName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Margin="0,0,12,10"><TextBlock Text="热键" Style="{StaticResource Caption}" /><controls:HotkeyRecorder Width="104" Height="34" Hotkey="{Binding NewHotkey, Mode=TwoWay}" /></StackPanel>
                            <StackPanel Margin="0,0,12,10"><TextBlock Text="点击 X" Style="{StaticResource Caption}" /><TextBox Width="68" Text="{Binding NewClickX, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Margin="0,0,12,10"><TextBlock Text="点击 Y" Style="{StaticResource Caption}" /><TextBox Width="68" Text="{Binding NewClickY, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Margin="0,0,0,10"><TextBlock Text="等待 ms" Style="{StaticResource Caption}" /><TextBox Width="82" Text="{Binding NewWaitMs, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        </WrapPanel>
                        <TextBlock Text="文本" Style="{StaticResource Caption}" Margin="0,2,0,4" />
                        <TextBox Text="{Binding NewText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="添加步骤" Style="{StaticResource PrimaryButton}" Height="34" Margin="0,12,0,0" Command="{Binding AddStepCommand}" />
                        <Button Content="清空流程" Style="{StaticResource GhostButton}" Height="32" Margin="0,8,0,0" Command="{Binding ClearStepsCommand}" />
                        <TextBlock Text="{Binding OperationStatus}" Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="载入" Style="{StaticResource GhostButton}" Width="58" Height="30" Command="{Binding ImportItemRulesCommand}" />
                            <TextBlock Text="物品规则" Style="{StaticResource H2}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding ItemRules}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,14,0,24">
                <StackPanel>
                    <TextBlock Text="步骤队列" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding Steps}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="98" />
                                        <ColumnDefinition Width="106" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding DataContext.TaskTypeNames, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding TaskType}" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding DataContext.Actions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Action}" Margin="0,0,8,0">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource GuildContributionStepActionText}}" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBox Grid.Column="3" Text="{Binding MapName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="4" Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                                    <TextBox Grid.Column="5" Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                                    <TextBox Grid.Column="6" Text="{Binding NpcName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                    <controls:HotkeyRecorder Grid.Column="7" Hotkey="{Binding Hotkey, Mode=TwoWay}" Height="30" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="8" Text="{Binding ClickX, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                                    <TextBox Grid.Column="9" Text="{Binding ClickY, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                                    <TextBox Grid.Column="10" Text="{Binding WaitMs, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="11" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                    <Button Grid.Column="12" Content="删除" Style="{StaticResource GhostButton}" Height="30"
                                            Command="{Binding DataContext.RemoveStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
