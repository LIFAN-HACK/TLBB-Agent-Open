<UserControl x:Class="TlbbAgent.App.Views.UtilityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TlbbAgent.App.Controls"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24,20"
                  PanningMode="VerticalOnly">
        <StackPanel MaxWidth="1120" HorizontalAlignment="Left">
            <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="#22222A35" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7"
                                 Height="7"
                                 VerticalAlignment="Center"
                                 Fill="{Binding RunState, Converter={StaticResource RunStateBrush}}" />
                        <TextBlock Text="{Binding CurrentStateName}"
                                   FontSize="10.5"
                                   Margin="6,0,0,0"
                                   Foreground="{StaticResource Text.SecondaryBrush}" />
                    </StackPanel>
                </Border>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
                    <TextBlock Text="背包识别与候选分析工作台"
                               Style="{StaticResource Label}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        CornerRadius="10"
                        BorderBrush="#355C49"
                        BorderThickness="1"
                        Background="#182A22"
                        Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="17" Background="#254535">
                            <TextBlock Text="✓"
                                       Foreground="{StaticResource OkBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,12,0">
                            <TextBlock Text="识别与候选分析可用" Style="{StaticResource H2}" />
                            <TextBlock Text="读取背包画面、识别格子并生成分类候选。"
                                       Style="{StaticResource Caption}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource Badge}" Background="#254535" VerticalAlignment="Center">
                            <TextBlock Text="可用" FontSize="10.5" Foreground="{StaticResource OkBrush}" />
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        CornerRadius="10"
                        BorderBrush="#66562B"
                        BorderThickness="1"
                        Background="#2A2518"
                        Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="17" Background="#443A20">
                            <TextBlock Text="!"
                                       Foreground="{StaticResource WarningBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,12,0">
                            <TextBlock Text="实际出售未接入"
                                       Style="{StaticResource H2}"
                                       Foreground="{StaticResource WarningBrush}" />
                            <TextBlock Text="不会点击候选物品，不会与 NPC 交易，也不会丢弃物品。"
                                       Style="{StaticResource Caption}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource Badge}" Background="#443A20" VerticalAlignment="Center">
                            <TextBlock Text="未接入" FontSize="10.5" Foreground="{StaticResource WarningBrush}" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,14">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="导入保护清单"
                                    Style="{StaticResource GhostButton}"
                                    Width="104"
                                    Height="32"
                                    Margin="0,0,8,0"
                                    Command="{Binding ImportLegacyCleanupListsCommand}" />
                            <Button Content="分析当前画面"
                                    Style="{StaticResource PrimaryButton}"
                                    Width="104"
                                    Height="32"
                                    Margin="0,0,8,0"
                                    Command="{Binding AnalyzeCleanupCommand}" />
                            <Button Content="打开背包并分析"
                                    Style="{StaticResource GhostButton}"
                                    Width="120"
                                    Height="32"
                                    Margin="0,0,8,0"
                                    Command="{Binding OpenBagThenAnalyzeCleanupCommand}" />
                            <Button Content="导出候选报告"
                                    Style="{StaticResource GhostButton}"
                                    Width="112"
                                    Height="32"
                                    Command="{Binding ExportCleanupCandidatesCommand}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="背包候选分析" Style="{StaticResource H2}" />
                            <TextBlock Text="所有操作均为只读分析"
                                       Style="{StaticResource Caption}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <Border CornerRadius="8"
                            BorderBrush="#66562B"
                            BorderThickness="1"
                            Background="#2A2518"
                            Padding="12,10"
                            Margin="0,14,0,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="#443A20" VerticalAlignment="Center">
                                <TextBlock Text="禁止实际出售" FontSize="10.5" Foreground="{StaticResource WarningBrush}" />
                            </Border>
                            <TextBlock Text="分析结果只是待人工核对的候选，不代表物品会被出售、交易或丢弃。"
                                       Style="{StaticResource Label}"
                                       Foreground="{StaticResource WarningBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,12,0" />
                        </DockPanel>
                    </Border>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="0.95*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                CornerRadius="8"
                                Padding="12,10"
                                Background="{StaticResource Bg.SurfaceAltBrush}">
                            <StackPanel>
                                <TextBlock Text="分析状态" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding CleanupScanSummary}"
                                           Style="{StaticResource Label}"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CleanupStatus}"
                                           Style="{StaticResource Caption}"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                CornerRadius="8"
                                Padding="12,10"
                                Background="{StaticResource Bg.SurfaceAltBrush}">
                            <StackPanel>
                                <TextBlock Text="安全检查" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding CleanupSafetySummary}"
                                           Style="{StaticResource Label}"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CleanupTemplateSummary}"
                                           Style="{StaticResource Caption}"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="保护规则" Style="{StaticResource Caption}" />
                        <WrapPanel Margin="0,8,0,0">
                            <Border Style="{StaticResource Badge}" Background="#24332C" Margin="0,0,8,8">
                                <TextBlock Text="{Binding CleanupKeepCount, StringFormat=保留名单 {0}}"
                                           Style="{StaticResource Caption}"
                                           Foreground="{StaticResource OkBrush}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Margin="0,0,8,8">
                                <TextBlock Text="{Binding CleanupStoreCount, StringFormat=存放分类 {0}}" Style="{StaticResource Caption}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Margin="0,0,8,8">
                                <TextBlock Text="{Binding CleanupTradeCount, StringFormat=交易分类 {0}}" Style="{StaticResource Caption}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Background="#443A20" Margin="0,0,8,8">
                                <TextBlock Text="{Binding CleanupSellKeywordCount, StringFormat=出售关键词（仅标记） {0}}"
                                           Style="{StaticResource Caption}"
                                           Foreground="{StaticResource WarningBrush}" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <Border CornerRadius="8"
                            BorderBrush="{StaticResource Stroke.SubtleBrush}"
                            BorderThickness="1"
                            Background="{StaticResource Bg.WindowBrush}"
                            Padding="12,10"
                            Margin="0,6,0,0">
                        <Expander IsExpanded="False">
                            <Expander.Header>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="载入保留物品"
                                            Style="{StaticResource GhostButton}"
                                            Width="104"
                                            Height="28"
                                            Margin="16,0,0,0"
                                            Command="{Binding ImportKeepItemsCommand}" />
                                    <StackPanel>
                                        <TextBlock Text="查看保留物品" Style="{StaticResource Label}" />
                                        <TextBlock Text="保留名单始终用于安全判定"
                                                   Style="{StaticResource Caption}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding KeepItems}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6"
                                                Background="{StaticResource Bg.SurfaceAltBrush}"
                                                Padding="8,5"
                                                Margin="0,0,0,5">
                                            <TextBlock Text="{Binding}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </Border>

                    <DockPanel Margin="0,16,0,8">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="#22222A35">
                            <TextBlock Text="人工复核" FontSize="10.5" Foreground="{StaticResource Text.SecondaryBrush}" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="识别候选" Style="{StaticResource H2}" />
                            <TextBlock Text="判定与分数仅供核对，不会触发游戏操作。"
                                       Style="{StaticResource Caption}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="格" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="1" Text="位置" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="2" Text="物品" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="3" Text="候选分类" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="4" Text="分数" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="5" Text="判定依据" Style="{StaticResource Caption}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding CleanupCandidates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6"
                                        Background="{StaticResource Bg.SurfaceAltBrush}"
                                        Padding="0,7"
                                        Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="74" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Index}" Style="{StaticResource Label}" Margin="6,0,0,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Position}" Style="{StaticResource Label}" />
                                        <TextBlock Grid.Column="2" Text="{Binding ItemName}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding Decision}" Style="{StaticResource Label}" />
                                        <TextBlock Grid.Column="4" Text="{Binding Score}" Style="{StaticResource Label}" />
                                        <TextBlock Grid.Column="5" Text="{Binding Reason}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,6,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,13" Visibility="Collapsed">
                <Expander IsExpanded="False">
                    <Expander.Header>
                        <StackPanel>
                            <TextBlock Text="高级识别设置" Style="{StaticResource H2}" />
                            <TextBlock Text="开包热键、网格校准与模板匹配"
                                       Style="{StaticResource Caption}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,14,0,0">
                        <Border CornerRadius="8"
                                BorderBrush="#66562B"
                                BorderThickness="1"
                                Background="#2A2518"
                                Padding="12,10">
                            <TextBlock Text="这些设置只影响识别质量。无论如何配置，当前版本都不会执行出售或丢弃。"
                                       Style="{StaticResource Caption}"
                                       Foreground="{StaticResource WarningBrush}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <WrapPanel Margin="0,14,0,0">
                            <StackPanel Width="128" Margin="0,0,12,10">
                                <TextBlock Text="扫描方式" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                                <ComboBox ItemsSource="{Binding CleanupScanModes}" SelectedItem="{Binding CleanupGridScanMode}" />
                            </StackPanel>
                            <StackPanel Width="150" Margin="0,0,12,10">
                                <TextBlock Text="打开背包" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                                <StackPanel Orientation="Horizontal" Height="34" VerticalAlignment="Center">
                                    <CheckBox Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding CleanupOpenBagBeforeScan}"
                                              Margin="0,0,8,0" />
                                    <controls:HotkeyRecorder Width="82"
                                                             Height="30"
                                                             Hotkey="{Binding CleanupOpenBagHotkey, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Width="88" Margin="0,0,12,10">
                                <TextBlock Text="启用网格" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                                <CheckBox Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding CleanupGridEnabled}"
                                          Margin="0,6,0,0" />
                            </StackPanel>
                            <Button Content="自动校准网格"
                                    Style="{StaticResource PrimaryButton}"
                                    Width="104"
                                    Height="32"
                                    Margin="0,18,8,10"
                                    Command="{Binding AutoCalibrateCleanupGridCommand}" />
                            <Button Content="保存网格"
                                    Style="{StaticResource GhostButton}"
                                    Width="88"
                                    Height="32"
                                    Margin="0,18,0,10"
                                    Command="{Binding SaveCleanupGridCommand}" />
                        </WrapPanel>

                        <WrapPanel Margin="0,2,0,0">
                            <StackPanel Width="64" Margin="0,0,8,10"><TextBlock Text="X" Style="{StaticResource Caption}" /><TextBox Text="{Binding CleanupGridX, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Width="64" Margin="0,0,8,10"><TextBlock Text="Y" Style="{StaticResource Caption}" /><TextBox Text="{Binding CleanupGridY, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Width="64" Margin="0,0,8,10"><TextBlock Text="列" Style="{StaticResource Caption}" /><TextBox Text="{Binding CleanupGridColumns, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Width="64" Margin="0,0,8,10"><TextBlock Text="行" Style="{StaticResource Caption}" /><TextBox Text="{Binding CleanupGridRows, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Width="72" Margin="0,0,8,10"><TextBlock Text="格宽" Style="{StaticResource Caption}" /><TextBox Text="{Binding CleanupCellWidth, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Width="72" Margin="0,0,8,10"><TextBlock Text="格高" Style="{StaticResource Caption}" /><TextBox Text="{Binding CleanupCellHeight, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Width="64" Margin="0,0,8,10"><TextBlock Text="横距" Style="{StaticResource Caption}" /><TextBox Text="{Binding CleanupGapX, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Width="64" Margin="0,0,12,10"><TextBlock Text="纵距" Style="{StaticResource Caption}" /><TextBox Text="{Binding CleanupGapY, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        </WrapPanel>

                        <Separator Margin="0,4,0,14" />

                        <WrapPanel>
                            <StackPanel Width="96" Margin="0,0,12,10">
                                <TextBlock Text="模板匹配" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                                <CheckBox Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding CleanupTemplateEnabled}"
                                          Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Width="320" Margin="0,0,12,10">
                                <TextBlock Text="模板索引" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding CleanupTemplateIndexPath, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <Button Content="选择"
                                    Style="{StaticResource GhostButton}"
                                    Width="64"
                                    Height="32"
                                    Margin="0,18,12,10"
                                    Command="{Binding BrowseCleanupTemplateIndexCommand}" />
                            <StackPanel Width="72" Margin="0,0,8,10">
                                <TextBlock Text="阈值" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding CleanupTemplateThreshold, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="72" Margin="0,0,0,10">
                                <TextBlock Text="内边距" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding CleanupTemplateInnerPadding, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Expander>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,24" Padding="16,13" Visibility="Collapsed">
                <Expander IsExpanded="False">
                    <Expander.Header>
                        <StackPanel>
                            <TextBlock Text="高级便捷动作编排" Style="{StaticResource H2}" />
                            <TextBlock Text="独立的键鼠动作工具，不代表清包出售能力"
                                       Style="{StaticResource Caption}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,14,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="保存方案"
                                        Style="{StaticResource GhostButton}"
                                        Width="82"
                                        Height="32"
                                        Margin="0,0,8,0"
                                        Command="{Binding SaveCommand}" />
                                <Button Content="加载方案"
                                        Style="{StaticResource GhostButton}"
                                        Width="82"
                                        Height="32"
                                        Command="{Binding LoadCommand}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="便捷方案" Style="{StaticResource H2}" />
                                <TextBlock Text="{Binding PlanSummary}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <WrapPanel Margin="0,14,0,0">
                            <StackPanel Width="150" Margin="0,0,12,10">
                                <TextBlock Text="配置名" Style="{StaticResource Caption}" />
                                <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="150" Margin="0,0,12,10">
                                <TextBlock Text="流程名" Style="{StaticResource Caption}" />
                                <TextBox Text="{Binding PlanName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="108" Margin="0,0,12,10">
                                <TextBlock Text="重复间隔 ms" Style="{StaticResource Caption}" />
                                <TextBox Text="{Binding RepeatIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="132" Margin="0,0,12,10">
                                <TextBlock Text="输入通道" Style="{StaticResource Caption}" />
                                <ComboBox ItemsSource="{Binding DispatchModes}" SelectedItem="{Binding DispatchMode}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource DispatchModeText}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,18,18,10">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StopAfterSequence}" Margin="0,0,8,0" />
                                <TextBlock Text="执行后停止" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,10">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RepeatSequence}" Margin="0,0,8,0" />
                                <TextBlock Text="循环执行" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>

                        <Separator Margin="0,4,0,14" />

                        <TextBlock Text="添加动作" Style="{StaticResource H2}" />
                        <WrapPanel Margin="0,12,0,0">
                            <StackPanel Width="120" Margin="0,0,12,10">
                                <TextBlock Text="分组" Style="{StaticResource Caption}" />
                                <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding NewGroup}">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource UtilityActionGroupText}}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Width="120" Margin="0,0,12,10">
                                <TextBlock Text="动作" Style="{StaticResource Caption}" />
                                <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding NewKind}">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource UtilityActionKindText}}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Width="130" Margin="0,0,12,10"><TextBlock Text="名称" Style="{StaticResource Caption}" /><TextBox Text="{Binding NewLabel, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Width="108" Margin="0,0,12,10"><TextBlock Text="热键" Style="{StaticResource Caption}" /><controls:HotkeyRecorder Height="34" Hotkey="{Binding NewHotkey, Mode=TwoWay}" /></StackPanel>
                            <StackPanel Width="70" Margin="0,0,12,10"><TextBlock Text="X" Style="{StaticResource Caption}" /><TextBox Text="{Binding NewClickX, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Width="70" Margin="0,0,12,10"><TextBlock Text="Y" Style="{StaticResource Caption}" /><TextBox Text="{Binding NewClickY, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Width="82" Margin="0,0,0,10"><TextBlock Text="等待 ms" Style="{StaticResource Caption}" /><TextBox Text="{Binding NewDelayAfterMs, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        </WrapPanel>
                        <TextBlock Text="文本" Style="{StaticResource Caption}" Margin="0,2,0,4" />
                        <TextBox Text="{Binding NewText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="添加动作"
                                Style="{StaticResource PrimaryButton}"
                                Width="96"
                                Height="34"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"
                                Command="{Binding AddStepCommand}" />
                        <TextBlock Text="{Binding OperationStatus}"
                                   Style="{StaticResource Caption}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap" />

                        <Separator Margin="0,14" />

                        <TextBlock Text="动作队列" Style="{StaticResource H2}" />
                        <ItemsControl ItemsSource="{Binding Steps}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="74" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.Groups, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Group}" Margin="0,0,8,0">
                                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource UtilityActionGroupText}}" /></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding DataContext.Kinds, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Kind}" Margin="0,0,8,0">
                                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource UtilityActionKindText}}" /></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBox Grid.Column="3" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                        <controls:HotkeyRecorder Grid.Column="4" Hotkey="{Binding Hotkey, Mode=TwoWay}" Height="30" Margin="0,0,8,0" />
                                        <TextBox Grid.Column="5" Text="{Binding ClickX, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                                        <TextBox Grid.Column="6" Text="{Binding ClickY, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                                        <TextBox Grid.Column="7" Text="{Binding DelayAfterMs, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                        <TextBox Grid.Column="8" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                        <Button Grid.Column="9" Content="↑" Style="{StaticResource GhostButton}" Height="30" Margin="0,0,4,0" Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Grid.Column="10" Content="↓" Style="{StaticResource GhostButton}" Height="30" Margin="0,0,4,0" Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Grid.Column="11" Content="删除" Style="{StaticResource GhostButton}" Height="30" Command="{Binding DataContext.RemoveStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
