<UserControl x:Class="TlbbAgent.App.Views.ActivityCenterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  PanningMode="VerticalOnly">
        <StackPanel Margin="24,20"
                    MaxWidth="960"
                    HorizontalAlignment="Stretch">
            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource H1}"
                       Margin="0,0,0,16" />

            <Border Style="{StaticResource Card}"
                    Padding="16,10">
                <StackPanel>
                    <Grid Margin="12,0,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="活动"
                                   Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="1"
                                   Text="找点方式"
                                   Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="2"
                                   Text="状态"
                                   Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="3"
                                   Text="启用"
                                   Style="{StaticResource Caption}"
                                   HorizontalAlignment="Right" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Activities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Bg.SurfaceAltBrush}"
                                        BorderBrush="{StaticResource Stroke.SubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="12,10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="72" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource Label}"
                                                   VerticalAlignment="Center" />

                                        <ComboBox Grid.Column="1"
                                                  Width="190"
                                                  HorizontalAlignment="Left"
                                                  ItemsSource="{Binding PointModeOptions}"
                                                  DisplayMemberPath="Display"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding PointSelectionMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  AutomationProperties.Name="{Binding Name}" />

                                        <Border Grid.Column="2"
                                                Style="{StaticResource Badge}"
                                                Background="{StaticResource Bg.SurfaceBrush}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="{StaticResource Text.MutedBrush}"
                                                       FontSize="11" />
                                        </Border>

                                        <CheckBox Grid.Column="3"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsBackendReady}"
                                                  AutomationProperties.Name="{Binding Name}"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
