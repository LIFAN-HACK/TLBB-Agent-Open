<UserControl x:Class="TlbbAgent.App.Views.QuestionBankPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel MaxWidth="1040" HorizontalAlignment="Left">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="检查文件" Style="{StaticResource GhostButton}" Width="82" Height="32" Margin="0,0,8,0"
                            Command="{Binding CheckEncryptedSampleCommand}" />
                    <Button Content="载入" Style="{StaticResource GhostButton}" Width="64" Height="32" Margin="0,0,8,0"
                            Command="{Binding ImportCommand}" />
                    <Button Content="导出" Style="{StaticResource PrimaryButton}" Width="64" Height="32"
                            Command="{Binding ExportCommand}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Label}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{Binding IsReady, Converter={StaticResource BoolToStableBg}}">
                            <TextBlock Text="{Binding ReadySummary}" FontSize="10.5" Foreground="{StaticResource Text.SecondaryBrush}" />
                        </Border>
                        <TextBlock Text="摘要" Style="{StaticResource H2}" />
                    </DockPanel>
                    <UniformGrid Columns="2" Margin="0,12,0,0">
                        <StackPanel Margin="0,0,14,10">
                            <TextBlock Text="题库" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding BankSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="导入" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding ImportSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="录入" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding EditSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="#22222A35" Margin="12,0,0,0">
                                <TextBlock FontSize="10.5" Foreground="{StaticResource Text.SecondaryBrush}">
                                    <Run Text="题目 " />
                                    <Run Text="{Binding EntryCount}" />
                                </TextBlock>
                            </Border>
                            <TextBlock Text="题库查询" Style="{StaticResource H2}" />
                        </DockPanel>
                        <TextBox Height="34"
                                 Margin="0,12,0,0"
                                 Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="输入题目关键词、答案、分类或标签" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />

                        <ItemsControl ItemsSource="{Binding Results}" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#10141C" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="72" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Question}" Style="{StaticResource Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Answer}" Foreground="{StaticResource Accent.HiBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Border Style="{StaticResource Badge}" Background="#22222A35" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Category}" FontSize="10.5" Foreground="{StaticResource Text.SecondaryBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Tags}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="删除"
                                                    Style="{StaticResource GhostButton}"
                                                    Width="58"
                                                    Height="30"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="手动录入" Style="{StaticResource H2}" />
                        <TextBlock Text="题目和答案必填。" Style="{StaticResource Caption}" Margin="0,4,0,12" />

                        <TextBlock Text="题目" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <TextBox MinHeight="58" TextWrapping="Wrap" AcceptsReturn="True"
                                 Text="{Binding NewQuestion, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="答案" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                        <TextBox MinHeight="58" TextWrapping="Wrap" AcceptsReturn="True"
                                 Text="{Binding NewAnswer, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="分类" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                        <TextBox Text="{Binding NewCategory, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="标签" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                        <TextBox Text="{Binding NewTags, UpdateSourceTrigger=PropertyChanged}" ToolTip="多个标签用分号分隔" />

                        <Button Content="保存题目"
                                Style="{StaticResource PrimaryButton}"
                                Height="34"
                                Margin="0,14,0,0"
                                Command="{Binding AddEntryCommand}" />

                        <Border CornerRadius="8" Background="#1FFBBF24" Padding="10,8" Margin="0,14,0,0"
                                Visibility="{Binding HasEncryptedSample, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="格式不支持。"
                                       Foreground="{StaticResource WarnBrush}"
                                       FontSize="11.5"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
