<UserControl x:Class="TlbbAgent.App.Views.LifeCollectPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TlbbAgent.App.Controls"
             Background="{StaticResource Bg.WindowBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
                        <Border Style="{StaticResource Badge}" Background="{Binding Descriptor.Status, Converter={StaticResource StatusBg}}" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Descriptor.Status, Converter={StaticResource StatusText}}" FontSize="11" Margin="6,0,0,0" Foreground="{StaticResource Text.SecondaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Label}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Border Style="{StaticResource Badge}" Margin="0,0,8,0">
                        <TextBlock>
                            <Run Text="状态机 " Foreground="{StaticResource Text.MutedBrush}" />
                            <Run Text="{Binding CurrentStateName, Mode=OneWay}" Foreground="{StaticResource Accent.CyanBrush}" FontFamily="Consolas" />
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource Badge}">
                        <TextBlock Text="{Binding RunState, Converter={StaticResource RunStateText}}" Foreground="{StaticResource Text.SecondaryBrush}" />
                    </Border>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{Binding IsReady, Converter={StaticResource BoolToStableBg}}">
                            <TextBlock Text="{Binding ReadySummary}" FontSize="10.5" Foreground="{StaticResource Text.SecondaryBrush}" />
                        </Border>
                        <TextBlock Text="摘要" Style="{StaticResource H2}" />
                    </DockPanel>
                    <UniformGrid Columns="2" Margin="0,12,0,0">
                        <StackPanel Margin="0,0,14,10">
                            <TextBlock Text="模式" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding ModeSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="路线" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding RouteSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,10">
                            <TextBlock Text="动作" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding ActionSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="节奏" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding TimingSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="导航" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding NavigationSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="识别区" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding RecognitionSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="设置" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding OperationStatus}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="载入路线1" Style="{StaticResource GhostButton}" Height="32" Margin="0,0,8,0" Command="{Binding ImportAWindowRoutesCommand}" />
                    <Button Content="载入路线2" Style="{StaticResource GhostButton}" Height="32" Command="{Binding ImportBWindowRoutesCommand}" />
                        </StackPanel>
                    </Grid>

                    <WrapPanel Margin="0,16,0,0">
                        <StackPanel Margin="0,0,14,12">
                            <TextBlock Text="配置名" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Width="180" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,12">
                            <TextBlock Text="模式" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <ComboBox Width="150" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource LifeCollectModeText}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,12">
                            <TextBlock Text="地图" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <ComboBox Width="160" ItemsSource="{Binding MapNames}" SelectedItem="{Binding MapName}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,12">
                            <TextBlock Text="资源关键字" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Width="220" Text="{Binding ResourceKeywords, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,12">
                            <TextBlock Text="扫描键" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <controls:HotkeyRecorder Width="116" Height="34" Hotkey="{Binding ScanHotkey, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,12">
                            <TextBlock Text="采集键" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <controls:HotkeyRecorder Width="116" Height="34" Hotkey="{Binding CollectHotkey, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,12">
                            <TextBlock Text="发送方式" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <ComboBox Width="150" ItemsSource="{Binding DispatchModes}" SelectedItem="{Binding DispatchMode}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource DispatchModeText}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>

                    <WrapPanel>
                        <StackPanel Margin="0,0,14,12">
                            <TextBlock Text="动作方式" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <ComboBox Width="190" ItemsSource="{Binding ActionModes}" SelectedItem="{Binding ActionMode}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource LifeCollectActionModeText}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,12">
                            <TextBlock Text="动作点击 X" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Width="90" Text="{Binding ActionClickX}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,12">
                            <TextBlock Text="动作点击 Y" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Width="90" Text="{Binding ActionClickY}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,12">
                            <TextBlock Text="扫描间隔 ms" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Width="100" Text="{Binding ScanIntervalMs}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,12">
                            <TextBlock Text="采集间隔 ms" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Width="100" Text="{Binding CollectIntervalMs}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,12">
                            <TextBlock Text="到点距离" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Width="90" Text="{Binding ArrivalDistance}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,12">
                            <TextBlock Text="失败重试" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Width="90" Text="{Binding MaxPointRetry}" />
                        </StackPanel>
                    </WrapPanel>

                    <WrapPanel Margin="0,2,0,0">
                        <StackPanel Margin="0,0,24,8">
                            <TextBlock Text="路线导航" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding EnableRouteNavigation}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,24,8">
                            <TextBlock Text="背包满停机" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding EnableBagFullStop}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                            <Button Content="保存本页配置" Style="{StaticResource GhostButton}" Height="32" Margin="0,0,8,0" Command="{Binding SaveCommand}" />
                            <Button Content="加载本页配置" Style="{StaticResource GhostButton}" Height="32" Command="{Binding LoadCommand}" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="路线导航" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding NavigationSummary}" Style="{StaticResource Caption}" Margin="0,4,0,12" />
                    <WrapPanel>
                        <StackPanel Margin="0,0,14,12">
                            <TextBlock Text="导航模式" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <ComboBox Width="190" ItemsSource="{Binding NavigationModes}" SelectedItem="{Binding NavigationMode}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource ReturnNavigationModeText}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,12">
                            <TextBlock Text="导航热键" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <controls:HotkeyRecorder Width="116" Height="34" Hotkey="{Binding NavigationHotkey, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,12">
                            <TextBlock Text="开图延迟 ms" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Width="110" Text="{Binding NavigationOpenMapDelayMs}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,12">
                            <TextBlock Text="点击 X" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Width="90" Text="{Binding NavigationClickX}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,12">
                            <TextBlock Text="点击 Y" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Width="90" Text="{Binding NavigationClickY}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,12">
                            <TextBlock Text="动作间隔 ms" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Width="110" Text="{Binding NavigationActionIntervalMs}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,12">
                            <TextBlock Text="发送方式" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <ComboBox Width="150" ItemsSource="{Binding DispatchModes}" SelectedItem="{Binding NavigationDispatchMode}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource DispatchModeText}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock Text="地图/坐标识别区" Style="{StaticResource Label}" Margin="0,6,0,8" />
                    <WrapPanel>
                        <StackPanel Margin="0,0,10,10"><TextBlock Text="地图 X" Style="{StaticResource Caption}" /><TextBox Width="72" Text="{Binding MapRegionX}" /></StackPanel>
                        <StackPanel Margin="0,0,10,10"><TextBlock Text="地图 Y" Style="{StaticResource Caption}" /><TextBox Width="72" Text="{Binding MapRegionY}" /></StackPanel>
                        <StackPanel Margin="0,0,10,10"><TextBlock Text="地图 W" Style="{StaticResource Caption}" /><TextBox Width="72" Text="{Binding MapRegionWidth}" /></StackPanel>
                        <StackPanel Margin="0,0,24,10"><TextBlock Text="地图 H" Style="{StaticResource Caption}" /><TextBox Width="72" Text="{Binding MapRegionHeight}" /></StackPanel>
                        <StackPanel Margin="0,0,10,10"><TextBlock Text="坐标 X" Style="{StaticResource Caption}" /><TextBox Width="72" Text="{Binding CoordinateRegionX}" /></StackPanel>
                        <StackPanel Margin="0,0,10,10"><TextBlock Text="坐标 Y" Style="{StaticResource Caption}" /><TextBox Width="72" Text="{Binding CoordinateRegionY}" /></StackPanel>
                        <StackPanel Margin="0,0,10,10"><TextBlock Text="坐标 W" Style="{StaticResource Caption}" /><TextBox Width="72" Text="{Binding CoordinateRegionWidth}" /></StackPanel>
                        <StackPanel Margin="0,0,0,10"><TextBlock Text="坐标 H" Style="{StaticResource Caption}" /><TextBox Width="72" Text="{Binding CoordinateRegionHeight}" /></StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="坐标路线" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding RouteSummary}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="添加" Style="{StaticResource GhostButton}" Height="32" Margin="0,0,8,0" Command="{Binding AddPointCommand}" />
                            <Button Content="清空" Style="{StaticResource GhostButton}" Height="32" Command="{Binding ClearPointsCommand}" />
                        </StackPanel>
                    </Grid>

                    <WrapPanel Margin="0,14,0,4">
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="新地图" Style="{StaticResource Caption}" /><TextBox Width="130" Text="{Binding NewMapName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="X" Style="{StaticResource Caption}" /><TextBox Width="80" Text="{Binding NewX}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="Y" Style="{StaticResource Caption}" /><TextBox Width="80" Text="{Binding NewY}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="备注" Style="{StaticResource Caption}" /><TextBox Width="150" Text="{Binding NewLabel, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    </WrapPanel>

                    <Border CornerRadius="7" Background="{StaticResource Bg.SurfaceAltBrush}" Padding="10" Margin="0,0,0,10">
                        <TextBlock Text="{Binding OperationStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding Points}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Margin="0,0,8,0" Text="{Binding MapName, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="1" Margin="0,0,8,0" Text="{Binding X}" />
                                    <TextBox Grid.Column="2" Margin="0,0,8,0" Text="{Binding Y}" />
                                    <TextBox Grid.Column="3" Margin="0,0,8,0" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="4" Content="删除" Style="{StaticResource GhostButton}" Width="64" Height="30"
                                            Command="{Binding DataContext.RemovePointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
