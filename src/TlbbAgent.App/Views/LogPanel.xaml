<UserControl x:Class="TlbbAgent.App.Views.LogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="40"
             HorizontalContentAlignment="Stretch"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <Style x:Key="LogActionButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style x:Key="LogColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource Bg.PanelBrush}"
            BorderBrush="Transparent"
            BorderThickness="0"
            CornerRadius="12"
            ClipToBounds="True"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="14,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="22" Height="22" CornerRadius="7"
                        Background="{StaticResource Accent.SoftBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE9D9;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="11"
                               Foreground="{StaticResource Accent.HiBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1"
                           Text="运行记录"
                           Style="{StaticResource H2}"
                           FontSize="13"
                           Margin="9,0,14,0"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            Margin="12,0,0,0"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                    <Button Content="复制"
                            Style="{StaticResource LogActionButton}"
                            Command="{Binding CopyCommand}" />
                    <Button Content="导出"
                            Style="{StaticResource LogActionButton}"
                            Margin="6,0,0,0"
                            Command="{Binding ExportCommand}" />
                    <Button Content="清空"
                            Style="{StaticResource LogActionButton}"
                            Margin="6,0,0,0"
                            Command="{Binding ClearCommand}" />
                </StackPanel>

                <Grid Grid.Column="4" Margin="8,0,0,0">
                    <Button Content="&#xE70E;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="11"
                            Style="{StaticResource GhostButton}"
                            Width="32"
                            Height="28"
                            Padding="0"
                            Command="{Binding ToggleExpandCommand}"
                            ToolTip="收起运行记录"
                            AutomationProperties.Name="收起运行记录"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                    <Button Content="&#xE70D;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="11"
                            Style="{StaticResource GhostButton}"
                            Width="32"
                            Height="28"
                            Padding="0"
                            Command="{Binding ToggleExpandCommand}"
                            ToolTip="展开运行记录"
                            AutomationProperties.Name="展开运行记录"
                            Visibility="{Binding IsExpanded, Converter={StaticResource InvBoolToVis}}" />
                </Grid>
            </Grid>

            <Border Grid.Row="1"
                    Height="140"
                    Background="{StaticResource Bg.WorkspaceBrush}"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="时间" Style="{StaticResource LogColumnHeader}" />
                        <TextBlock Grid.Column="1" Text="状态" Style="{StaticResource LogColumnHeader}" />
                        <TextBlock Grid.Column="2" Text="事件" Style="{StaticResource LogColumnHeader}" />
                    </Grid>

                    <ListBox x:Name="EntriesList"
                             Grid.Row="1"
                             ItemsSource="{Binding Entries}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Message}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="row" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Stretch" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="row" Property="Background" Value="{StaticResource Bg.PanelHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="row" Property="Background" Value="{StaticResource Accent.SoftBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="24" Margin="14,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Time, StringFormat=HH:mm:ss}"
                                               FontFamily="Consolas"
                                               FontSize="11.5"
                                               Foreground="{StaticResource Text.MutedBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding LevelText}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding Level, Converter={StaticResource LevelBrush}}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Message}"
                                               FontSize="11.5"
                                               Foreground="{StaticResource Text.PrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Message}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
