<UserControl x:Class="TlbbAgent.App.Views.ModeConfigPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel MaxWidth="920" HorizontalAlignment="Left">
            <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" VerticalAlignment="Center"
                        Background="{Binding Status, Converter={StaticResource StatusBg}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}" FontSize="11" Margin="6,0,0,0" Foreground="{StaticResource Text.SecondaryBrush}" />
                    </StackPanel>
                </Border>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Label}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Border Style="{StaticResource Badge}" Background="#1F4C82F7">
                    <TextBlock Text="{Binding Priority}" FontSize="10.5" Foreground="{StaticResource Accent.HiBrush}" />
                </Border>
                <Border Style="{StaticResource Badge}" Background="#22222A35" Margin="8,0,0,0">
                    <TextBlock Text="{Binding Group}" FontSize="10.5" Foreground="{StaticResource Text.SecondaryBrush}" />
                </Border>
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,18,0,0"
                    Visibility="{Binding HasController, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="状态机" Style="{StaticResource Caption}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding RunState, Converter={StaticResource RunStateBrush}}" />
                        <TextBlock Text="{Binding RunState, Converter={StaticResource RunStateText}}" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Label}" />
                        <Border CornerRadius="6" Background="{StaticResource Bg.WindowBrush}" Padding="8,3" Margin="12,0,0,0">
                            <TextBlock Text="{Binding CurrentStateName}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Accent.CyanBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="左侧控制。" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="独立配置" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding ConfigHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,12" />
                    <Border CornerRadius="8" Background="{StaticResource Bg.WindowBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Padding="14">
                        <StackPanel>
                            <TextBlock Text="独立保存。" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
