<UserControl x:Class="TlbbAgent.App.Views.MaterialProcessingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  PanningMode="VerticalOnly">
        <StackPanel Margin="24,20" MaxWidth="1120" HorizontalAlignment="Stretch">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="材料加工" Style="{StaticResource H1}" VerticalAlignment="Center" />

                <Border Grid.Column="1"
                        Style="{StaticResource Badge}"
                        Background="#24F59E0B"
                        Margin="12,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource WarnBrush}"
                                 Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource WarnBrush}" FontSize="12" />
                    </StackPanel>
                </Border>

            </Grid>

            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="自动材料加工" Style="{StaticResource H2}" VerticalAlignment="Center" />
                        <CheckBox Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding EnabledIntent, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEnableIntent}"
                                  HorizontalAlignment="Right"
                                  AutomationProperties.Name="启用自动材料加工" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="加工周期"
                                   Style="{StaticResource Label}"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding ProcessingCycleMinutes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 HorizontalContentAlignment="Right"
                                 AutomationProperties.Name="材料加工周期" />
                        <TextBlock Grid.Column="2"
                                   Text="分钟"
                                   Style="{StaticResource Label}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
