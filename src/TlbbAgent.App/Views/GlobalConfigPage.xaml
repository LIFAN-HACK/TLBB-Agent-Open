<UserControl x:Class="TlbbAgent.App.Views.GlobalConfigPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:TlbbAgent.App.Controls"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch"
                      PanningMode="VerticalOnly">
        <StackPanel Margin="24,20" MaxWidth="1120" HorizontalAlignment="Stretch">
            <TextBlock Text="角色设置" Style="{StaticResource H1}" Margin="0,0,0,16" />

            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="通用配置" Style="{StaticResource H2}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="1.35*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="门派" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                            <ComboBox ItemsSource="{Binding Schools}"
                                      SelectedItem="{Binding SelectedSchool}"
                                      DisplayMemberPath="Display" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="选择 / 切换目标" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                            <ctl:HotkeyRecorder Hotkey="{Binding AcquireHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="内置挂机快捷键" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                            <ctl:HotkeyRecorder Hotkey="{Binding GameBuiltInHangSwitchHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <DockPanel Margin="0,0,0,7">
                                <CheckBox DockPanel.Dock="Right"
                                          Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding YieldToManualInput}" />
                                <TextBlock Text="玩家操作保护"
                                           Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="18" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="暂停" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding ManualInputYieldSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.0}}"
                                         TextAlignment="Center"
                                         MaxLength="3" />
                                <TextBlock Grid.Column="2"
                                           Text="?"
                                           Style="{StaticResource Label}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="恢复配置" Style="{StaticResource H2}" />

                    <StackPanel Margin="0,14,0,0">
                        <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,8" Background="{StaticResource Bg.SurfaceAltBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="164" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="18" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="角色回血" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding HealthRecoveryModes}"
                                          DisplayMemberPath="Display"
                                          SelectedItem="{Binding SelectedHealthRecoveryMode, Mode=TwoWay}" />
                                <ctl:HotkeyRecorder Grid.Column="3" Width="120" HorizontalAlignment="Left"
                                                    Visibility="{Binding IsMedicineHealthRecovery, Converter={StaticResource BoolToVis}}"
                                                    Hotkey="{Binding HealHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="3" Text="自动点击技能槽" Style="{StaticResource Label}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsMedicineHealthRecovery, Converter={StaticResource InvBoolToVis}}" />
                                <TextBlock Grid.Column="4" Text="{Binding HealthRecoveryHint}" Style="{StaticResource Caption}"
                                           Margin="14,0" VerticalAlignment="Center" />
                                <TextBox Grid.Column="5"
                                         Text="{Binding HpThresholdPct, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}"
                                         TextAlignment="Center" MaxLength="3" />
                                <TextBlock Grid.Column="6" Text="%" Style="{StaticResource Caption}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,8" Background="{StaticResource Bg.SurfaceAltBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="164" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="18" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="角色回蓝" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding ManaRecoveryModes}"
                                          DisplayMemberPath="Display"
                                          SelectedItem="{Binding SelectedManaRecoveryMode, Mode=TwoWay}" />
                                <ctl:HotkeyRecorder Grid.Column="3" Width="120" HorizontalAlignment="Left"
                                                    Visibility="{Binding IsMedicineManaRecovery, Converter={StaticResource BoolToVis}}"
                                                    Hotkey="{Binding ManaHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="3" Text="自动点击技能槽" Style="{StaticResource Label}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsMedicineManaRecovery, Converter={StaticResource InvBoolToVis}}" />
                                <TextBlock Grid.Column="4" Text="{Binding ManaRecoveryHint}" Style="{StaticResource Caption}"
                                           Margin="14,0" VerticalAlignment="Center" />
                                <TextBox Grid.Column="5"
                                         Text="{Binding MpThresholdPct, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}"
                                         TextAlignment="Center" MaxLength="3" />
                                <TextBlock Grid.Column="6" Text="%" Style="{StaticResource Caption}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border CornerRadius="8" Padding="14,10" Background="{StaticResource Bg.SurfaceAltBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="164" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="18" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="宠物恢复" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="宠物口粮" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                <ctl:HotkeyRecorder Grid.Column="3" Width="120" HorizontalAlignment="Left"
                                                    Hotkey="{Binding PetFoodHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="4" Text="按宠物血量快速补满" Style="{StaticResource Caption}"
                                           Margin="14,0" VerticalAlignment="Center" />
                                <TextBox Grid.Column="5"
                                         Text="{Binding PetFoodThresholdPct, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}"
                                         TextAlignment="Center" MaxLength="3" />
                                <TextBlock Grid.Column="6" Text="%" Style="{StaticResource Caption}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="112" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="目标策略" Style="{StaticResource H2}" />
                        <TextBlock Text="管理普通怪物、BOSS 与玩家目标的允许规则。"
                                   Style="{StaticResource Caption}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding TargetPolicySummary}"
                               Style="{StaticResource Caption}"
                               VerticalAlignment="Center" />
                    <CheckBox Grid.Column="3"
                              Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding IsTargetPolicyEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.Name="启用目标策略"
                              VerticalAlignment="Center" />
                    <Button Grid.Column="5"
                            Content="管理目标"
                            Style="{StaticResource GhostButton}"
                            Height="32"
                            Command="{Binding OpenTargetPolicyManagerCommand}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="技能预设" Style="{StaticResource H2}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SkillSummary}"
                                   Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="3"
                                Content="{Binding SkillEditorButtonText}"
                                Style="{StaticResource GhostButton}"
                                Height="32"
                                Command="{Binding ToggleSkillEditorCommand}" />
                    </Grid>

                    <Border Background="{StaticResource Bg.SurfaceAltBrush}" CornerRadius="8" Padding="12,8" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ListBox Style="{StaticResource InlineChoiceList}"
                                     ItemsSource="{Binding SkillModes}"
                                     SelectedItem="{Binding SelectedSkillMode}"
                                     SelectionMode="Single"
                                     DisplayMemberPath="Name" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding SkillModeText}"
                                       Style="{StaticResource Label}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource Bg.SurfaceAltBrush}"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,10,0,0"
                            Visibility="{Binding IsAiSkillMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="AI 自动判定会读取当前技能槽截图、技能身份和冷却状态；未识别成功的技能不会参与释放。"
                                   Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Margin="0,12,0,0"
                                Visibility="{Binding ShowCustomSkillEditor, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="10,0,10,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="顺序" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="1" Text="启用" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="2" Text="类型" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="3" Text="名称" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="4" Text="快捷键" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="5" Text="CD(秒)" Style="{StaticResource Caption}" />
                        </Grid>

                        <Border CornerRadius="8" Padding="10,8" Margin="0,0,0,5" Background="{StaticResource Bg.SurfaceAltBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="固定" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="固定" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="普通攻击" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="普通攻击" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                <ctl:HotkeyRecorder Grid.Column="4"
                                                    Margin="0,0,8,0"
                                                    Hotkey="{Binding AttackHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Skills}"
                                      AllowDrop="True"
                                      PreviewDragOver="SkillList_PreviewDragOver"
                                      PreviewDrop="SkillList_Drop">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="10,8" Margin="0,0,0,5" Background="{StaticResource Bg.SurfaceAltBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="34" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Width="34"
                                                    Height="30"
                                                    Background="Transparent"
                                                    Cursor="SizeAll"
                                                    ToolTip="拖动调整释放顺序"
                                                    PreviewMouseLeftButtonDown="SkillDragHandle_PreviewMouseLeftButtonDown"
                                                    PreviewMouseMove="SkillDragHandle_PreviewMouseMove">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="≡" FontSize="16" Foreground="{StaticResource Text.MutedBrush}" />
                                                    <TextBlock Text="{Binding OrderText}" Margin="3,0,0,0" Style="{StaticResource Caption}" />
                                                </StackPanel>
                                            </Border>
                                            <CheckBox Grid.Column="1"
                                                      Style="{StaticResource ToggleSwitch}"
                                                      IsChecked="{Binding Enabled}"
                                                      VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="2"
                                                      Margin="0,0,8,0"
                                                      ItemsSource="{Binding KindOptions}"
                                                      SelectedItem="{Binding SelectedKind}" />
                                            <TextBox Grid.Column="3"
                                                     Margin="0,0,8,0"
                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                            <ctl:HotkeyRecorder Grid.Column="4"
                                                                Margin="0,0,8,0"
                                                                Hotkey="{Binding Hotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Grid.Column="5"
                                                     Margin="0,0,8,0"
                                                     Text="{Binding IntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="6"
                                                    Style="{StaticResource GhostButton}"
                                                    Height="30"
                                                    Width="28"
                                                    Padding="0"
                                                    Content="×"
                                                    ToolTip="删除技能"
                                                    Command="{Binding DataContext.RemoveSkillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+ 添加技能"
                                Style="{StaticResource GhostButton}"
                                Height="32"
                                HorizontalAlignment="Left"
                                Margin="0,6,0,0"
                                Command="{Binding AddSkillCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Background="#D8080C12"
                Panel.ZIndex="20"
                AutomationProperties.Name="目标策略管理窗口"
                Visibility="{Binding IsTargetPolicyManagerOpen, Converter={StaticResource BoolToVis}}">
            <Grid Margin="24">
                <Border Width="980"
                        MaxWidth="980"
                        MaxHeight="720"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        CornerRadius="8"
                        Background="{StaticResource Bg.SurfaceBrush}"
                        BorderBrush="{StaticResource StrokeStrongBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="68" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="58" />
                        </Grid.RowDefinitions>

                        <Grid Margin="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="目标管理" Style="{StaticResource H2}" />
                                <TextBlock Text="按分类新增、编辑或删除目标。"
                                           Style="{StaticResource Caption}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="关闭"
                                    Style="{StaticResource GhostButton}"
                                    Width="76"
                                    Height="32"
                                    VerticalAlignment="Center"
                                    Command="{Binding CloseTargetPolicyManagerCommand}" />
                        </Grid>

                        <ScrollViewer Grid.Row="1"
                                      Margin="20,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding TargetPolicyCategories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8"
                                                Padding="14"
                                                Margin="0,0,0,10"
                                                Background="{StaticResource Bg.SurfaceAltBrush}"
                                                BorderBrush="{StaticResource Stroke.SubtleBrush}"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="46" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="46" />
                                                        <ColumnDefinition Width="190" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="96" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Style="{StaticResource ToggleSwitch}"
                                                              IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              AutomationProperties.Name="启用分类"
                                                              VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Display}"
                                                               Style="{StaticResource Label}"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Summary}"
                                                               Style="{StaticResource Caption}"
                                                               VerticalAlignment="Center" />
                                                    <CheckBox Grid.Column="3"
                                                              Style="{StaticResource ToggleSwitch}"
                                                              IsChecked="{Binding AllowUnlisted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              AutomationProperties.Name="允许未列出目标"
                                                              VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4"
                                                               Text="允许未列出"
                                                               Style="{StaticResource Caption}"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="5"
                                                               Text="{Binding Hint}"
                                                               Style="{StaticResource Caption}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                    <Button Grid.Column="6"
                                                            Content="添加目标"
                                                            Style="{StaticResource GhostButton}"
                                                            Height="30"
                                                            Command="{Binding AddEntryCommand}" />
                                                </Grid>

                                                <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Entries}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,7">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="46" />
                                                                    <ColumnDefinition Width="52" />
                                                                    <ColumnDefinition Width="46" />
                                                                    <ColumnDefinition Width="88" />
                                                                    <ColumnDefinition Width="240" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="72" />
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox Style="{StaticResource ToggleSwitch}"
                                                                          IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          AutomationProperties.Name="启用目标"
                                                                          VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="启用"
                                                                           Style="{StaticResource Caption}"
                                                                           Margin="8,0,0,0"
                                                                           VerticalAlignment="Center" />
                                                                <CheckBox Grid.Column="2"
                                                                          Style="{StaticResource ToggleSwitch}"
                                                                          IsChecked="{Binding AllowAttack, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          AutomationProperties.Name="允许攻击目标"
                                                                          VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="3"
                                                                           Text="允许攻击"
                                                                           Style="{StaticResource Caption}"
                                                                           Margin="8,0,8,0"
                                                                           VerticalAlignment="Center" />
                                                                <TextBox Grid.Column="4"
                                                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                                <TextBlock Grid.Column="5"
                                                                           Text="{Binding SourceText}"
                                                                           Style="{StaticResource Caption}"
                                                                           Margin="12,0"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center" />
                                                                <Button Grid.Column="6"
                                                                        Content="删除"
                                                                        Style="{StaticResource GhostButton}"
                                                                        Height="30"
                                                                        AutomationProperties.Name="删除目标"
                                                                        Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Grid Grid.Row="2" Margin="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="未识别目标默认按当前分类规则处理。"
                                       Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="完成"
                                    Style="{StaticResource PrimaryButton}"
                                    Width="96"
                                    Height="34"
                                    VerticalAlignment="Center"
                                    Command="{Binding CloseTargetPolicyManagerCommand}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
