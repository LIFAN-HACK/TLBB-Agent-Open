<UserControl x:Class="TlbbAgent.App.Views.AutoCleanupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  PanningMode="VerticalOnly">
        <StackPanel Margin="24,20" MaxWidth="1120" HorizontalAlignment="Stretch">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="自动清包" Style="{StaticResource H1}" VerticalAlignment="Center" />

                <Border Grid.Column="1"
                        Style="{StaticResource Badge}"
                        Background="#24F59E0B"
                        Margin="12,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource WarnBrush}"
                                 Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource WarnBrush}" FontSize="12" />
                    </StackPanel>
                </Border>

            </Grid>

            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="自动清包" Style="{StaticResource H2}" VerticalAlignment="Center" />
                        <CheckBox Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding EnabledIntent, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEnableIntent}"
                                  HorizontalAlignment="Right"
                                  AutomationProperties.Name="启用自动清包" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="清包方式" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding Modes}"
                                      DisplayMemberPath="Display"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Visibility="{Binding IsReturnToCity, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="回城地点" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding Cities}"
                                      DisplayMemberPath="Display"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedCity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Border Style="{StaticResource Badge}" Background="{StaticResource Accent.SoftBrush}" Margin="0,0,8,0">
                            <TextBlock Text="只生成候选" Foreground="{StaticResource Accent.HiBrush}" FontSize="11" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="{StaticResource Accent.SoftBrush}">
                            <TextBlock Text="未知物品保护" Foreground="{StaticResource Accent.HiBrush}" FontSize="11" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="允许出售名单" Style="{StaticResource H2}" Margin="0,0,0,10" />
                        <TextBox Text="{Binding AllowedSellItemsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Height="170"
                                 AutomationProperties.Name="允许出售名单" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="保留名单" Style="{StaticResource H2}" Margin="0,0,0,10" />
                        <TextBox Text="{Binding KeepItemsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Height="170"
                                 AutomationProperties.Name="保留名单" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
