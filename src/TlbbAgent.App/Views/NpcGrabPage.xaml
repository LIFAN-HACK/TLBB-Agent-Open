<UserControl x:Class="TlbbAgent.App.Views.NpcGrabPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TlbbAgent.App.Controls"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">
            <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" VerticalAlignment="Center"
                        Background="{Binding Descriptor.Status, Converter={StaticResource StatusBg}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding Descriptor.Status, Converter={StaticResource StatusBrush}}" />
                        <TextBlock Text="{Binding Descriptor.Status, Converter={StaticResource StatusText}}" FontSize="11" Margin="6,0,0,0" Foreground="{StaticResource Text.SecondaryBrush}" />
                    </StackPanel>
                </Border>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Label}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding HasController, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="运行" Style="{StaticResource Caption}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding RunState, Converter={StaticResource RunStateBrush}}" />
                        <TextBlock Text="{Binding RunState, Converter={StaticResource RunStateText}}" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Label}" />
                        <Border CornerRadius="6" Background="{StaticResource Bg.WindowBrush}" Padding="8,3" Margin="12,0,0,0">
                            <TextBlock Text="{Binding CurrentStateName}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Accent.CyanBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{Binding IsReady, Converter={StaticResource BoolToStableBg}}">
                            <TextBlock Text="{Binding ReadySummary}" FontSize="10.5" Foreground="{StaticResource Text.SecondaryBrush}" />
                        </Border>
                        <TextBlock Text="摘要" Style="{StaticResource H2}" />
                    </DockPanel>
                    <UniformGrid Columns="2" Margin="0,12,0,0">
                        <StackPanel Margin="0,0,14,10">
                            <TextBlock Text="目标" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding TargetMatrixSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="节奏" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding TimingSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="动作" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding ActionSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="快抢" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding SmallFastSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="恢复默认" Style="{StaticResource GhostButton}" Height="30" Width="84" Margin="0,0,8,0" Command="{Binding ResetDefaultsCommand}" />
                            <Button Content="应用" Style="{StaticResource GhostButton}" Height="30" Width="64" Margin="0,0,8,0" Command="{Binding ApplyCommand}" />
                            <Button Content="保存" Style="{StaticResource PrimaryButton}" Height="30" Width="64" Margin="0,0,8,0" Command="{Binding SaveCommand}" />
                            <Button Content="加载" Style="{StaticResource GhostButton}" Height="30" Width="64" Command="{Binding LoadCommand}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="设置" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding EnabledSummary}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="{Binding OperationStatus}" Style="{StaticResource Caption}" Margin="0,12,0,0" />

                    <WrapPanel Margin="0,14,0,0">
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="配置名" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Width="150" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="扫描键" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <controls:HotkeyRecorder Width="116" Height="34" Hotkey="{Binding ScanHotkey, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="动作键" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <controls:HotkeyRecorder Width="116" Height="34" Hotkey="{Binding ActionHotkey, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="动作方式" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <ComboBox Width="150" ItemsSource="{Binding ActionModes}" SelectedItem="{Binding ActionMode}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="发送方式" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <ComboBox Width="130" ItemsSource="{Binding DispatchModes}" SelectedItem="{Binding DispatchMode}" />
                        </StackPanel>
                    </WrapPanel>

                    <WrapPanel Margin="0,2,0,0">
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="扫描间隔 ms" Style="{StaticResource Caption}" Margin="0,0,0,4" /><TextBox Width="96" Text="{Binding ScanIntervalMs, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="点击间隔 ms" Style="{StaticResource Caption}" Margin="0,0,0,4" /><TextBox Width="96" Text="{Binding ClickIntervalMs, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="重试延迟 ms" Style="{StaticResource Caption}" Margin="0,0,0,4" /><TextBox Width="96" Text="{Binding RetryDelayMs, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="重试次数" Style="{StaticResource Caption}" Margin="0,0,0,4" /><TextBox Width="76" Text="{Binding RetryLimit, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="点击 X" Style="{StaticResource Caption}" Margin="0,0,0,4" /><TextBox Width="76" Text="{Binding ClickX, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Margin="0,0,0,10"><TextBlock Text="点击 Y" Style="{StaticResource Caption}" Margin="0,0,0,4" /><TextBox Width="76" Text="{Binding ClickY, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="#1F60A5FA">
                            <TextBlock Text="默认双通道" FontSize="10.5" Foreground="{StaticResource Text.SecondaryBrush}" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="抢小 / 小小快抢" Style="{StaticResource H2}" />
                            <TextBlock Text="刷新窗口" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>

                    <WrapPanel Margin="0,14,0,0">
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="策略" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <ComboBox Width="160" ItemsSource="{Binding SmallStrategies}" SelectedItem="{Binding SmallStrategy}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource SmallNpcStrategyText}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="刷新分钟" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Width="150" Text="{Binding RefreshMinuteMarks, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="提前秒" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Width="76" Text="{Binding RefreshWindowBeforeSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="延后秒" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Width="76" Text="{Binding RefreshWindowAfterSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="高频扫描 ms" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Width="96" Text="{Binding BurstScanIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </WrapPanel>

                    <WrapPanel Margin="0,2,0,0">
                        <StackPanel Margin="0,0,18,10">
                            <TextBlock Text="高频识别" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding EnableRefreshBurst}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,18,10">
                            <TextBlock Text="上下文快抢" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding EnableContextFastAction}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,18,10">
                            <TextBlock Text="窗口内快抢" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ContextFastOnlyInRefreshWindow}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="上下文有效秒" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Width="96" Text="{Binding ContextValidSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="每窗口快抢次数" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Width="96" Text="{Binding MaxContextFastAttemptsPerWindow, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="目标" Style="{StaticResource H2}" />

                    <ItemsControl ItemsSource="{Binding Targets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="300" CornerRadius="8" Background="{StaticResource Bg.SurfaceAltBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Padding="10" Margin="0,0,10,10">
                                    <StackPanel>
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Label}" />
                                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                                    <Run Text="词 " />
                                                    <Run Text="{Binding KeywordCount, Mode=OneWay}" />
                                                    <Run Text=" / 优先 " />
                                                    <Run Text="{Binding Priority}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBox Text="{Binding Keywords, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0" />
                                        <TextBox Width="68" HorizontalAlignment="Left" Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,24">
                <StackPanel>
                    <TextBlock Text="识别区" Style="{StaticResource H2}" />
                    <WrapPanel>
                        <StackPanel Margin="0,0,18,10">
                            <TextBlock Text="启用识别" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding TargetNameEnabled}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="X" Style="{StaticResource Caption}" Margin="0,0,0,4" /><TextBox Width="76" Text="{Binding TargetNameX, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="Y" Style="{StaticResource Caption}" Margin="0,0,0,4" /><TextBox Width="76" Text="{Binding TargetNameY, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="宽" Style="{StaticResource Caption}" Margin="0,0,0,4" /><TextBox Width="76" Text="{Binding TargetNameWidth, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Margin="0,0,0,10"><TextBlock Text="高" Style="{StaticResource Caption}" Margin="0,0,0,4" /><TextBox Width="76" Text="{Binding TargetNameHeight, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
