<UserControl x:Class="TlbbAgent.App.Views.TradePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TlbbAgent.App.Controls"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel MaxWidth="1080" HorizontalAlignment="Left">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="载入路线" Style="{StaticResource GhostButton}" Width="82" Height="32" Margin="0,0,8,0"
                            Command="{Binding ImportRouteCommand}" />
                    <Button Content="保存" Style="{StaticResource GhostButton}" Width="62" Height="32" Margin="0,0,8,0"
                            Command="{Binding SaveCommand}" />
                    <Button Content="加载" Style="{StaticResource PrimaryButton}" Width="62" Height="32"
                            Command="{Binding LoadCommand}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Label}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{Binding IsReady, Converter={StaticResource BoolToStableBg}}">
                            <TextBlock Text="{Binding ReadySummary}" FontSize="10.5" Foreground="{StaticResource Text.SecondaryBrush}" />
                        </Border>
                        <TextBlock Text="摘要" Style="{StaticResource H2}" />
                    </DockPanel>
                    <UniformGrid Columns="2" Margin="0,12,0,0">
                        <StackPanel Margin="0,0,14,10">
                            <TextBlock Text="路线" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding RouteSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="执行" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding ExecutionSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,10">
                            <TextBlock Text="节奏" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding TimingSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="导航" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding NavigationSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="结束" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding RouteEndSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="#22222A35">
                            <TextBlock Text="{Binding CurrentStateName}" FontSize="10.5" Foreground="{StaticResource Text.SecondaryBrush}" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="设置" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding RouteSummary}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <WrapPanel Margin="0,14,0,0">
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="方案名" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Width="150" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="路线名" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Width="150" Text="{Binding RouteName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="动作模式" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <ComboBox Width="150" ItemsSource="{Binding ExecutionModes}" SelectedItem="{Binding ExecutionMode}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource TradeExecutionModeText}}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="发送" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <ComboBox Width="130" ItemsSource="{Binding DispatchModes}" SelectedItem="{Binding DispatchMode}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource DispatchModeText}}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="默认热键" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <controls:HotkeyRecorder Width="110" Hotkey="{Binding OpenMapHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </WrapPanel>

                    <WrapPanel Margin="0,4,0,0">
                        <DockPanel Width="128" Margin="0,0,16,8">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LoopRoute}" />
                            <TextBlock Text="循环路线" Style="{StaticResource Label}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Width="148" Margin="0,0,16,8">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StopWhenRouteEnds}" />
                            <TextBlock Text="结束后停止" Style="{StaticResource Label}" VerticalAlignment="Center" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,8">
                            <TextBlock Text="到点距离" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Width="56" Text="{Binding ArrivalDistance, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,8">
                            <TextBlock Text="步骤间隔" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Width="72" Text="{Binding StepIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,8">
                            <TextBlock Text="动作间隔" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Width="72" Text="{Binding ActionIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,8">
                            <TextBlock Text="重试" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Width="56" Text="{Binding MaxStepRetry, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock Text="{Binding OperationStatus}" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="新增步骤" Style="{StaticResource H2}" />
                    <TextBlock Text="地图、坐标、动作。" Style="{StaticResource Caption}" Margin="0,4,0,12" TextWrapping="Wrap" />

                        <WrapPanel>
                            <StackPanel Margin="0,0,8,10">
                                <TextBlock Text="地图" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <TextBox Width="138" Text="{Binding NewMapName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,10">
                                <TextBlock Text="X" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <TextBox Width="58" Text="{Binding NewX, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Y" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <TextBox Width="58" Text="{Binding NewY, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </WrapPanel>

                        <TextBlock Text="动作" Style="{StaticResource Caption}" Margin="0,2,0,4" />
                        <ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding NewAction}" Height="30">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Converter={StaticResource TradeRouteActionText}}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="NPC" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                        <TextBox Text="{Binding NewNpcName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="商品" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                        <TextBox Text="{Binding NewGoodsName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="热键" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                        <controls:HotkeyRecorder Hotkey="{Binding NewHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <WrapPanel Margin="0,12,0,0">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="点击 X" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <TextBox Width="74" Text="{Binding NewClickX, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="点击 Y" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <TextBox Width="74" Text="{Binding NewClickY, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </WrapPanel>

                        <Button Content="添加步骤" Style="{StaticResource PrimaryButton}" Height="34" Margin="0,14,0,0" Command="{Binding AddPointCommand}" />
                        <Button Content="清空路线" Style="{StaticResource GhostButton}" Height="32" Margin="0,8,0,0" Command="{Binding ClearPointsCommand}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="路线步骤" Style="{StaticResource H2}" />
                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{Binding RunState, Converter={StaticResource StatusBg}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding RunState, Converter={StaticResource RunStateBrush}}" />
                                    <TextBlock Text="{Binding RunState, Converter={StaticResource RunStateText}}" FontSize="10.5" Margin="6,0,0,0" Foreground="{StaticResource Text.SecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding Points}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#10141C" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="108" />
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="64" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                            <TextBox Grid.Column="1" Text="{Binding MapName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                            <TextBox Grid.Column="2" Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                            <TextBox Grid.Column="3" Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                            <ComboBox Grid.Column="4" ItemsSource="{Binding DataContext.Actions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Action}" Margin="0,0,8,0">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource TradeRouteActionText}}" /></DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <StackPanel Grid.Column="5" Orientation="Horizontal">
                                                <TextBox Width="86" Text="{Binding NpcName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" ToolTip="NPC" />
                                                <TextBox Width="86" Text="{Binding GoodsName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" ToolTip="商品" />
                                                <controls:HotkeyRecorder Width="76" Hotkey="{Binding Hotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                                <TextBox Width="50" Text="{Binding ClickX, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" ToolTip="点击 X" />
                                                <TextBox Width="50" Text="{Binding ClickY, UpdateSourceTrigger=PropertyChanged}" ToolTip="点击 Y" />
                                            </StackPanel>
                                            <Button Grid.Column="6" Content="删除" Style="{StaticResource GhostButton}" Height="30"
                                                    Command="{Binding DataContext.RemovePointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="导航参数" Style="{StaticResource H2}" />
                    <WrapPanel Margin="0,12,0,0">
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="导航模式" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <ComboBox Width="190" ItemsSource="{Binding NavigationModes}" SelectedItem="{Binding NavigationMode}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource ReturnNavigationModeText}}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="导航热键" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <controls:HotkeyRecorder Width="110" Hotkey="{Binding NavigationHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="点击 X" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Width="70" Text="{Binding NavigationClickX, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="点击 Y" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Width="70" Text="{Binding NavigationClickY, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="导航间隔" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Width="82" Text="{Binding NavigationActionIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
