<UserControl x:Class="TlbbAgent.App.Views.HangPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:TlbbAgent.App.Controls"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer x:Name="PageScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  Padding="24,20"
                  PanningMode="VerticalOnly">
        <StackPanel MaxWidth="1120" HorizontalAlignment="Stretch">
            <DockPanel>
                <Border DockPanel.Dock="Right"
                        Style="{StaticResource Badge}"
                        VerticalAlignment="Center"
                        Background="{Binding IsConfigComplete, Converter={StaticResource BoolToStableBg}}">
                    <TextBlock Text="{Binding ConfigSummary}"
                               FontSize="11"
                               Foreground="{StaticResource Text.SecondaryBrush}" />
                </Border>
                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
            </DockPanel>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="打怪模式" Style="{StaticResource H2}" />
                        <ListBox Margin="0,14,0,0"
                                 Style="{StaticResource InlineChoiceList}"
                                 ItemsSource="{Binding CombatModes}"
                                 SelectedItem="{Binding SelectedCombatMode}"
                                 IsEnabled="{Binding CanChangeMode}"
                                 SelectionMode="Single">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource InlineChoiceItem}">
                                    <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource Badge}"
                                                Background="#2A2518"
                                                Margin="8,0,0,0"
                                                Visibility="{Binding ShowPendingBadge, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="未就绪"
                                                       FontSize="10.5"
                                                       Foreground="{StaticResource WarningBrush}" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="运行状态" Style="{StaticResource H2}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="10"
                                     Height="10"
                                     VerticalAlignment="Center"
                                     Fill="{Binding RunState, Converter={StaticResource RunStateBrush}}" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{Binding RunState, Converter={StaticResource RunStateText}}"
                                           Style="{StaticResource Label}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}"
                    Padding="16,14"
                    Margin="0,14,0,0"
                    Visibility="{Binding IsBuiltInMode, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right"
                                Style="{StaticResource Badge}"
                                Background="{StaticResource Accent.SoftBrush}">
                            <TextBlock Text="{Binding BuiltInMonitorStatus}"
                                       FontSize="10.5"
                                       Foreground="{StaticResource Text.SecondaryBrush}" />
                        </Border>
                        <TextBlock Text="内置挂机监控" Style="{StaticResource H2}" />
                    </DockPanel>

                    <Border Margin="0,14,0,0"
                            CornerRadius="8"
                            Padding="12,10"
                            Background="{StaticResource Bg.SurfaceAltBrush}">
                            <StackPanel>
                                <TextBlock Text="内置挂机快捷键" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding BuiltInHotkeySummary}"
                                           Style="{StaticResource Label}"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}"
                    Padding="16,14"
                    Margin="0,14,0,0"
                    Visibility="{Binding IsKeyMode, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="按键打怪" Style="{StaticResource H2}" />

                    <Border CornerRadius="8"
                            Padding="12,11"
                            Margin="0,14,0,0"
                            Background="{StaticResource Bg.SurfaceAltBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ListBox Style="{StaticResource InlineChoiceList}"
                                     ItemsSource="{Binding SkillModes}"
                                     SelectedItem="{Binding SelectedSkillMode}"
                                     SelectionMode="Single"
                                     DisplayMemberPath="Name" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding SkillModeText}" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding SkillModeDetail}"
                                           Style="{StaticResource Caption}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border CornerRadius="8"
                            Padding="12,11"
                            Margin="0,10,0,0"
                            Background="{StaticResource Bg.SurfaceAltBrush}"
                            Visibility="{Binding IsAiSkillMode, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding AiSkillInventoryStatus}"
                                       Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding AiSkillSlots}" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="118"
                                                Margin="0,0,8,8"
                                                Padding="8"
                                                CornerRadius="8"
                                                Background="{StaticResource Bg.SurfaceBrush}"
                                                BorderBrush="{StaticResource StrokeStrongBrush}"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <Image Source="{Binding Preview}"
                                                       Width="36"
                                                       Height="36"
                                                       HorizontalAlignment="Left"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                <TextBlock Text="{Binding SkillName}"
                                                           Style="{StaticResource Label}"
                                                           Margin="0,6,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ActionText}"
                                                           Style="{StaticResource Caption}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding CooldownText}"
                                                           Style="{StaticResource Caption}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <UniformGrid Columns="2" Margin="0,14,0,0">
                        <Border CornerRadius="8"
                                Padding="12,11"
                                Margin="0,0,7,0"
                                Background="{StaticResource Bg.SurfaceAltBrush}">
                            <StackPanel>
                                <TextBlock Text="目标范围" Style="{StaticResource Label}" />
                                <DockPanel Margin="0,14,0,0">
                                    <CheckBox DockPanel.Dock="Right"
                                              Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding AttackPlayers}" />
                                    <TextBlock Text="攻击玩家"
                                               Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="8"
                                Padding="12,11"
                                Margin="7,0,0,0"
                                Background="{StaticResource Bg.SurfaceAltBrush}"
                                Visibility="{Binding IsEmei, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="峨眉加血" Style="{StaticResource Label}" />
                                <DockPanel Margin="0,12,0,0">
                                    <CheckBox DockPanel.Dock="Right"
                                              Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding EnableSelfHeal}" />
                                    <TextBlock Text="给自己"
                                               Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,14,0,24">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource Badge}"
                                    Background="{Binding AutoReturnEnabled, Converter={StaticResource BoolToStableBg}}"
                                    Margin="0,0,10,0">
                                <TextBlock Text="{Binding AutoReturnStatus}"
                                           FontSize="10.5"
                                           Foreground="{StaticResource Text.SecondaryBrush}" />
                            </Border>
                            <CheckBox Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding AutoReturnEnabled}" />
                        </StackPanel>
                        <TextBlock Text="自动返点" Style="{StaticResource H2}" />
                    </DockPanel>

                    <Border Margin="0,14,0,0"
                            CornerRadius="8"
                            Padding="12,10"
                            Background="{StaticResource Bg.SurfaceAltBrush}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="土灵珠返点"
                                       Style="{StaticResource Label}" />
                            <TextBlock Text="返点方式" Style="{StaticResource Caption}" />
                        </DockPanel>
                    </Border>

                    <StackPanel Margin="0,10,0,0"
                                Visibility="{Binding AutoReturnEnabled, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="土灵珠快捷键" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                        <ctl:HotkeyRecorder Width="180"
                                            HorizontalAlignment="Left"
                                            Hotkey="{Binding EarthSpiritHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
