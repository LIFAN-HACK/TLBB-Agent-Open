<UserControl x:Class="TlbbAgent.App.Views.BossModePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  Padding="24,20">
        <StackPanel MaxWidth="920" HorizontalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="BOSS 模式" Style="{StaticResource H1}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="启用" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding IsModeEnabled, Mode=TwoWay}"
                              IsEnabled="{Binding IsBackendReady}" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="运行能力" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource Label}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="2" Text="BOSS 目标数据" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding WhitelistSummary}" Style="{StaticResource Label}"
                                   VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Button Content="管理目标策略"
                                Style="{StaticResource GhostButton}"
                                Height="34"
                                IsEnabled="{Binding CanManageWhitelist}"
                                Command="{Binding ManagePolicyCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Margin="2,12,0,0"
                       Text="启动后只允许 BOSS 分类目标；安全规则中的召唤物和跟班仍优先禁止。"
                       Style="{StaticResource Caption}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
