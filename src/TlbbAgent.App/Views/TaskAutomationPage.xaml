<UserControl x:Class="TlbbAgent.App.Views.TaskAutomationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  PanningMode="VerticalOnly">
        <StackPanel Margin="24,20" MaxWidth="1120" HorizontalAlignment="Stretch">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="日常任务"
                           Style="{StaticResource H1}"
                           VerticalAlignment="Center" />

                <Border Grid.Column="1"
                        Style="{StaticResource Badge}"
                        Background="#24F59E0B"
                        Margin="12,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6"
                                 Height="6"
                                 Fill="{StaticResource WarnBrush}"
                                 Margin="0,0,7,0"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Status}"
                                   Foreground="{StaticResource WarnBrush}"
                                   FontSize="12" />
                    </StackPanel>
                </Border>

            </Grid>

            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="执行顺序" Style="{StaticResource H2}" Margin="0,0,0,12" />

                    <ListBox x:Name="TaskList"
                             ItemsSource="{Binding Tasks}"
                             AllowDrop="True"
                             Drop="TaskList_Drop"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Bg.SurfaceAltBrush}"
                                        BorderBrush="{StaticResource Stroke.SubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="10"
                                        Margin="0,0,0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="30"
                                                Height="34"
                                                Background="{StaticResource Bg.SurfaceBrush}"
                                                CornerRadius="7"
                                                Cursor="SizeAll"
                                                PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="DragHandle_PreviewMouseMove">
                                            <TextBlock Text="⋮⋮"
                                                       Foreground="{StaticResource Text.MutedBrush}"
                                                       FontSize="14"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Number}"
                                                   Foreground="{StaticResource Text.MutedBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Name}"
                                                   Style="{StaticResource Label}"
                                                   VerticalAlignment="Center" />

                                        <CheckBox Grid.Column="3"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                  AutomationProperties.Name="{Binding Name}"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="师门任务" Style="{StaticResource H2}" Margin="0,0,0,12" />

                    <UniformGrid Columns="4">
                        <Border Background="{StaticResource Bg.SurfaceAltBrush}" CornerRadius="9" Padding="12" Margin="0,0,7,0">
                            <Grid>
                                <TextBlock Text="打怪" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                <CheckBox Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding AllowCombat, Mode=TwoWay}"
                                          HorizontalAlignment="Right"
                                          AutomationProperties.Name="允许打怪任务" />
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource Bg.SurfaceAltBrush}" CornerRadius="9" Padding="12" Margin="0,0,7,0">
                            <Grid>
                                <TextBlock Text="送信" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                <CheckBox Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding AllowDelivery, Mode=TwoWay}"
                                          HorizontalAlignment="Right"
                                          AutomationProperties.Name="允许送信任务" />
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource Bg.SurfaceAltBrush}" CornerRadius="9" Padding="12" Margin="0,0,7,0">
                            <Grid>
                                <TextBlock Text="抓宝宝" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                <CheckBox Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding AllowPetCapture, Mode=TwoWay}"
                                          HorizontalAlignment="Right"
                                          AutomationProperties.Name="允许抓宝宝任务" />
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource Bg.SurfaceAltBrush}" CornerRadius="9" Padding="12">
                            <Grid>
                                <TextBlock Text="买物品（关闭即放弃）" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                <CheckBox Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding AllowItemPurchase, Mode=TwoWay}"
                                          HorizontalAlignment="Right"
                                          AutomationProperties.Name="允许买物品任务" />
                            </Grid>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
