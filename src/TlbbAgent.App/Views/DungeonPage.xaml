<UserControl x:Class="TlbbAgent.App.Views.DungeonPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TlbbAgent.App.Controls"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel MaxWidth="1020" HorizontalAlignment="Left">
            <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" VerticalAlignment="Center"
                        Background="{Binding Descriptor.Status, Converter={StaticResource StatusBg}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding Descriptor.Status, Converter={StaticResource StatusBrush}}" />
                        <TextBlock Text="{Binding Descriptor.Status, Converter={StaticResource StatusText}}" FontSize="11" Margin="6,0,0,0" Foreground="{StaticResource Text.SecondaryBrush}" />
                    </StackPanel>
                </Border>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Label}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding HasController, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="运行" Style="{StaticResource Caption}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding RunState, Converter={StaticResource RunStateBrush}}" />
                        <TextBlock Text="{Binding RunState, Converter={StaticResource RunStateText}}" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Label}" />
                        <Border CornerRadius="6" Background="{StaticResource Bg.WindowBrush}" Padding="8,3" Margin="12,0,0,0">
                            <TextBlock Text="{Binding CurrentStateName}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Accent.CyanBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{Binding IsReady, Converter={StaticResource BoolToStableBg}}">
                            <TextBlock Text="{Binding ReadySummary}" FontSize="10.5" Foreground="{StaticResource Text.SecondaryBrush}" />
                        </Border>
                        <TextBlock Text="摘要" Style="{StaticResource H2}" />
                    </DockPanel>
                    <UniformGrid Columns="2" Margin="0,12,0,0">
                        <StackPanel Margin="0,0,14,10">
                            <TextBlock Text="模式" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding ModeSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="脚本" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding StepSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,10">
                            <TextBlock Text="热键" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding HotkeySummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="流程" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding FlowSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="导航" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding NavigationSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="完成" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding CompletionSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="默认脚本" Style="{StaticResource GhostButton}" Width="84" Height="30" Margin="0,0,8,0" Command="{Binding ResetDefaultsCommand}" />
                            <Button Content="保存" Style="{StaticResource PrimaryButton}" Width="64" Height="30" Margin="0,0,8,0" Command="{Binding SaveCommand}" />
                            <Button Content="加载" Style="{StaticResource GhostButton}" Width="64" Height="30" Command="{Binding LoadCommand}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="副本方案" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding StepSummary}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding OperationStatus}" Style="{StaticResource Caption}" Margin="0,12,0,0" />

                    <WrapPanel Margin="0,14,0,0">
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="配置名" Style="{StaticResource Caption}" Margin="0,0,0,4" /><TextBox Width="150" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="副本模式" Style="{StaticResource Caption}" Margin="0,0,0,4" /><ComboBox Width="140" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="次数" Style="{StaticResource Caption}" Margin="0,0,0,4" /><TextBox Width="70" Text="{Binding RunCount, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="队伍编号" Style="{StaticResource Caption}" Margin="0,0,0,4" /><TextBox Width="80" Text="{Binding TeamNumber, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Margin="0,0,18,10"><TextBlock Text="我去左桥" Style="{StaticResource Caption}" Margin="0,0,0,6" /><CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IGoLeftBridge}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="新三2 boss 站位" Style="{StaticResource Caption}" Margin="0,0,0,4" /><ComboBox Width="150" ItemsSource="{Binding BossPositions}" SelectedItem="{Binding NewThreeBoss2Position}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="站位 X" Style="{StaticResource Caption}" Margin="0,0,0,4" /><TextBox Width="72" Text="{Binding NewThreeBoss2CustomX, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Margin="0,0,0,10"><TextBlock Text="站位 Y" Style="{StaticResource Caption}" Margin="0,0,0,4" /><TextBox Width="72" Text="{Binding NewThreeBoss2CustomY, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    </WrapPanel>

                    <WrapPanel Margin="0,2,0,0">
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="启动副本键" Style="{StaticResource Caption}" Margin="0,0,0,4" /><controls:HotkeyRecorder Width="116" Height="34" Hotkey="{Binding StartDungeonHotkey, Mode=TwoWay}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="交互键" Style="{StaticResource Caption}" Margin="0,0,0,4" /><controls:HotkeyRecorder Width="116" Height="34" Hotkey="{Binding InteractHotkey, Mode=TwoWay}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="攻击键" Style="{StaticResource Caption}" Margin="0,0,0,4" /><controls:HotkeyRecorder Width="116" Height="34" Hotkey="{Binding AttackHotkey, Mode=TwoWay}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="清包键" Style="{StaticResource Caption}" Margin="0,0,0,4" /><controls:HotkeyRecorder Width="116" Height="34" Hotkey="{Binding ClearBagHotkey, Mode=TwoWay}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="退出键" Style="{StaticResource Caption}" Margin="0,0,0,4" /><controls:HotkeyRecorder Width="116" Height="34" Hotkey="{Binding ExitDungeonHotkey, Mode=TwoWay}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="步骤间隔 ms" Style="{StaticResource Caption}" Margin="0,0,0,4" /><TextBox Width="92" Text="{Binding StepIntervalMs, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Margin="0,0,0,10"><TextBlock Text="战斗检测 ms" Style="{StaticResource Caption}" Margin="0,0,0,4" /><TextBox Width="92" Text="{Binding BattleCheckIntervalMs, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    </WrapPanel>

                    <WrapPanel Margin="0,2,0,0">
                        <StackPanel Margin="0,0,18,10"><TextBlock Text="结束清包" Style="{StaticResource Caption}" Margin="0,0,0,6" /><CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding EnableClearBagAfterFinish}" /></StackPanel>
                        <StackPanel Margin="0,0,18,10"><TextBlock Text="任务衔接" Style="{StaticResource Caption}" Margin="0,0,0,6" /><CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding EnableChainNextTask}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="衔接模式 key" Style="{StaticResource Caption}" Margin="0,0,0,4" /><TextBox Width="160" Text="{Binding ChainNextModeKey, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    </WrapPanel>

                    <TextBlock Text="完成关键词" Style="{StaticResource Caption}" Margin="0,8,0,4" />
                    <TextBox Width="640" Text="{Binding CompletionKeywords, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="新增步骤" Style="{StaticResource GhostButton}" Width="84" Height="30" Margin="0,0,8,0" Command="{Binding AddStepCommand}" />
                            <Button Content="清空当前" Style="{StaticResource GhostButton}" Width="84" Height="30" Command="{Binding ClearStepsCommand}" />
                        </StackPanel>
                        <TextBlock Text="副本脚本步骤" Style="{StaticResource H2}" />
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding Steps}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Background="{StaticResource Bg.SurfaceAltBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="135" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="62" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding Order, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                        <TextBox Grid.Column="1" Text="{Binding StageName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                        <TextBox Grid.Column="2" Text="{Binding MapName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                        <TextBox Grid.Column="3" Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                        <TextBox Grid.Column="4" Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                        <ComboBox Grid.Column="5" ItemsSource="{Binding DataContext.StepActions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Action}" Margin="0,0,8,0" />
                                        <TextBox Grid.Column="6" Text="{Binding Hotkey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                        <TextBox Grid.Column="7" Text="{Binding ClickX, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                        <TextBox Grid.Column="8" Text="{Binding ClickY, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                        <TextBox Grid.Column="9" Text="{Binding DelayAfterMs, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                        <Button Grid.Column="10" Content="删除" Style="{StaticResource GhostButton}" Command="{Binding DataContext.RemoveStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="阶段导航" Style="{StaticResource H2}" />
                    <WrapPanel Margin="0,12,0,0">
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="模式" Style="{StaticResource Caption}" Margin="0,0,0,4" /><ComboBox Width="170" ItemsSource="{Binding NavigationModes}" SelectedItem="{Binding StageNavigationMode}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="热键" Style="{StaticResource Caption}" Margin="0,0,0,4" /><controls:HotkeyRecorder Width="116" Height="34" Hotkey="{Binding StageNavigationHotkey, Mode=TwoWay}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="点击 X" Style="{StaticResource Caption}" Margin="0,0,0,4" /><TextBox Width="76" Text="{Binding StageNavigationClickX, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="点击 Y" Style="{StaticResource Caption}" Margin="0,0,0,4" /><TextBox Width="76" Text="{Binding StageNavigationClickY, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="间隔 ms" Style="{StaticResource Caption}" Margin="0,0,0,4" /><TextBox Width="86" Text="{Binding StageNavigationActionIntervalMs, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Margin="0,0,0,10"><TextBlock Text="发送" Style="{StaticResource Caption}" Margin="0,0,0,4" /><ComboBox Width="130" ItemsSource="{Binding DispatchModes}" SelectedItem="{Binding StageNavigationDispatchMode}" /></StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,24">
                <StackPanel>
                    <TextBlock Text="完成识别区" Style="{StaticResource H2}" />
                    <WrapPanel Margin="0,12,0,0">
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="X" Style="{StaticResource Caption}" /><TextBox Width="72" Text="{Binding CompletionRegionX}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="Y" Style="{StaticResource Caption}" /><TextBox Width="72" Text="{Binding CompletionRegionY}" /></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="宽" Style="{StaticResource Caption}" /><TextBox Width="72" Text="{Binding CompletionRegionWidth}" /></StackPanel>
                        <StackPanel Margin="0,0,0,10"><TextBlock Text="高" Style="{StaticResource Caption}" /><TextBox Width="72" Text="{Binding CompletionRegionHeight}" /></StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
