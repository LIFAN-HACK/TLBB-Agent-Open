<UserControl x:Class="TlbbAgent.App.Views.MaterialCraftPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TlbbAgent.App.Controls"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel MaxWidth="1040" HorizontalAlignment="Left">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="载入流程" Style="{StaticResource GhostButton}" Width="82" Height="32" Margin="0,0,8,0"
                            Command="{Binding ImportPlanCommand}" />
                    <Button Content="保存" Style="{StaticResource GhostButton}" Width="62" Height="32" Margin="0,0,8,0"
                            Command="{Binding SaveCommand}" />
                    <Button Content="加载" Style="{StaticResource PrimaryButton}" Width="62" Height="32"
                            Command="{Binding LoadCommand}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Label}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{Binding IsReady, Converter={StaticResource BoolToStableBg}}">
                            <TextBlock Text="{Binding ReadySummary}" FontSize="10.5" Foreground="{StaticResource Text.SecondaryBrush}" />
                        </Border>
                        <TextBlock Text="摘要" Style="{StaticResource H2}" />
                    </DockPanel>
                    <UniformGrid Columns="2" Margin="0,12,0,0">
                        <StackPanel Margin="0,0,14,10">
                            <TextBlock Text="流程" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding PlanSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="执行" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding RunSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="节奏" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding TimingSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="清包" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding CleanupSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="#22222A35">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding RunState, Converter={StaticResource RunStateBrush}}" />
                                    <TextBlock Text="{Binding RunState, Converter={StaticResource RunStateText}}" FontSize="10.5" Margin="6,0,0,0" Foreground="{StaticResource Text.SecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="流程配置" Style="{StaticResource H2}" />
                                <TextBlock Text="{Binding PlanSummary}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <WrapPanel Margin="0,14,0,0">
                            <StackPanel Margin="0,0,12,10">
                                <TextBlock Text="配置名" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <TextBox Width="140" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,10">
                                <TextBlock Text="流程名" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <TextBox Width="140" Text="{Binding PlanName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,10">
                                <TextBlock Text="批次" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <TextBox Width="64" Text="{Binding BatchCount, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,10">
                                <TextBlock Text="步骤间隔" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <TextBox Width="84" Text="{Binding StepIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,10">
                                <TextBlock Text="重试" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <TextBox Width="64" Text="{Binding MaxStepRetry, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="发送" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <ComboBox Width="132" ItemsSource="{Binding DispatchModes}" SelectedItem="{Binding DispatchMode}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Converter={StaticResource DispatchModeText}}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </WrapPanel>

                        <WrapPanel Margin="0,2,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,10">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LoopPlan}" Margin="0,0,8,0" />
                                <TextBlock Text="循环流程" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,10">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StopAfterBatch}" Margin="0,0,8,0" />
                                <TextBlock Text="批次后停止" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding EnableCleanupAfterBatch}" Margin="0,0,8,0" />
                                <TextBlock Text="结束清包" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>

                        <Border CornerRadius="8" Background="{StaticResource Bg.WindowBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Padding="12" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="清包动作" Style="{StaticResource H2}" />
                                <WrapPanel Margin="0,10,0,0">
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Text="热键" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                        <controls:HotkeyRecorder Width="116" Height="34" Hotkey="{Binding CleanupHotkey, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Text="点击 X" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                        <TextBox Width="72" Text="{Binding CleanupClickX, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Text="点击 Y" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                        <TextBox Width="72" Text="{Binding CleanupClickY, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="等待 ms" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                        <TextBox Width="82" Text="{Binding CleanupWaitMs, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="添加步骤" Style="{StaticResource H2}" />
                        <WrapPanel Margin="0,14,0,0">
                            <StackPanel Margin="0,0,12,10">
                                <TextBlock Text="动作" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <ComboBox Width="124" ItemsSource="{Binding Actions}" SelectedItem="{Binding NewAction}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Converter={StaticResource MaterialCraftStepActionText}}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,10">
                                <TextBlock Text="材料" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <TextBox Width="116" Text="{Binding NewMaterialName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="配方" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <TextBox Width="116" Text="{Binding NewRecipeName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,10">
                                <TextBlock Text="热键" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <controls:HotkeyRecorder Width="116" Height="34" Hotkey="{Binding NewHotkey, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,10">
                                <TextBlock Text="点击 X" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <TextBox Width="72" Text="{Binding NewClickX, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,10">
                                <TextBlock Text="点击 Y" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <TextBox Width="72" Text="{Binding NewClickY, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="等待 ms" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <TextBox Width="82" Text="{Binding NewWaitMs, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Text="文本" Style="{StaticResource Caption}" Margin="0,2,0,4" />
                        <TextBox Text="{Binding NewText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="添加步骤" Style="{StaticResource PrimaryButton}" Height="34" Margin="0,12,0,0"
                                Command="{Binding AddStepCommand}" />
                        <Button Content="清空流程" Style="{StaticResource GhostButton}" Height="32" Margin="0,8,0,0"
                                Command="{Binding ClearStepsCommand}" />
                        <TextBlock Text="{Binding OperationStatus}" Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,14,0,24">
                <StackPanel>
                    <TextBlock Text="步骤队列" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding Steps}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="94" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="118" />
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.Actions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding Action}" Margin="0,0,8,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Converter={StaticResource MaterialCraftStepActionText}}" /></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBox Grid.Column="2" Text="{Binding MaterialName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" ToolTip="材料" />
                                    <TextBox Grid.Column="3" Text="{Binding RecipeName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" ToolTip="配方" />
                                    <controls:HotkeyRecorder Grid.Column="4" Hotkey="{Binding Hotkey, Mode=TwoWay}" Height="30" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="5" Text="{Binding ClickX, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" ToolTip="点击 X" />
                                    <TextBox Grid.Column="6" Text="{Binding ClickY, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" ToolTip="点击 Y" />
                                    <TextBox Grid.Column="7" Text="{Binding WaitMs, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" ToolTip="等待 ms" />
                                    <TextBox Grid.Column="8" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" ToolTip="文本" />
                                    <Button Grid.Column="9" Content="删除" Style="{StaticResource GhostButton}" Height="30"
                                            Command="{Binding DataContext.RemoveStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
