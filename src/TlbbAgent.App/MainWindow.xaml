<Window x:Class="TlbbAgent.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:TlbbAgent.App.Views"
        Title="TLBB Agent" Icon="Assets/Brand/tlbb-agent-v2.ico"
        Height="900" Width="1440" MinHeight="760" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg.SidebarBrush}"
        Foreground="{StaticResource Text.PrimaryBrush}"
        FontFamily="{StaticResource AppFont}"
        WindowStyle="None" ResizeMode="CanResize">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" CornerRadius="16"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="PrimaryNavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text.SecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="9" Padding="13,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#12FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource Text.PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#205B8CFF" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryNavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text.SecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="{StaticResource Bg.SurfaceAltBrush}"
                                BorderBrush="Transparent" BorderThickness="0"
                                CornerRadius="9" Padding="12,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#205B8CFF" />
                                <Setter Property="Foreground" Value="{StaticResource Text.PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#245B8CFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SessionItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,9" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="{StaticResource Bg.SurfaceBrush}"
                                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Bg.SurfaceAltBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource StrokeStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1C5B8CFF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.72" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatShellButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Text.PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Bg.SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Bg.ElevatedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Accent.SoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Bg.SidebarBrush}" BorderBrush="Transparent" BorderThickness="0"
            ClipToBounds="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="16" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="Maximized">
                        <Setter Property="CornerRadius" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource Bg.SidebarBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="314" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                    <Image Source="Assets/Brand/official-xtl-primary-logo.png"
                           Width="108" Height="44" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TLBB Agent" FontSize="13.5" FontWeight="SemiBold" />
                        <TextBlock Text="新一代的AI智能辅助系统" FontSize="10.5" Foreground="{StaticResource Text.MutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}" Content="−" FontSize="17" Click="OnMinimize" ToolTip="最小化" />
                    <Button Style="{StaticResource CaptionButton}" Content="□" FontSize="15" Click="OnMaximizeRestore" ToolTip="最大化" />
                    <Button Style="{StaticResource CloseButton}" Content="×" FontSize="18" Click="OnClose" ToolTip="关闭" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="314" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="Transparent"
                        BorderBrush="Transparent" BorderThickness="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="16,15,14,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="游戏窗口" Style="{StaticResource H2}" FontSize="14" />
                                <Border Style="{StaticResource Badge}" Background="{StaticResource Bg.ElevatedBrush}" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Sessions.Count}" FontSize="10.5" Foreground="{StaticResource Text.SecondaryBrush}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="14,0,14,16">
                                <ItemsControl ItemsSource="{Binding Sessions}"
                                              MaxHeight="244">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,9" Padding="10" CornerRadius="12"
                                                    BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource Bg.SurfaceBrush}" />
                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Background" Value="#17243A" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource Accent.HiBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="42" Height="42" CornerRadius="10" ClipToBounds="True"
                                                            Background="{StaticResource BrandGradient}"
                                                            BorderBrush="#385B8CFF" BorderThickness="1">
                                                        <Grid>
                                                            <Image Source="{Binding Avatar}" Stretch="UniformToFill"
                                                                   Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock Text="角" FontSize="12" FontWeight="SemiBold" Foreground="White"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding HasAvatar, Converter={StaticResource InvBoolToVis}}" />
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="8,1,8,0">
                                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}"
                                                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                                     Fill="{Binding RunState, Converter={StaticResource RunStateBrush}}" />
                                                            <TextBlock Text="{Binding RunState, Converter={StaticResource RunStateText}}"
                                                                       Style="{StaticResource Caption}" Margin="5,0,0,0" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <Button Grid.Column="2" Content="{Binding SelectButtonText}"
                                                            Style="{StaticResource GhostButton}" Height="28" MinWidth="48" Padding="9,0"
                                                            IsEnabled="{Binding CanSelect}"
                                                            Command="{Binding DataContext.SelectGameWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border x:Name="Crosshair" Height="68" CornerRadius="11" BorderThickness="0"
                                        BorderBrush="Transparent" Background="#15182028"
                                        Cursor="SizeAll" MouseLeftButtonDown="OnCrosshairDown" Margin="0,0,0,10">
                                    <Grid Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="8" Background="#1F5B8CFF">
                                            <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                       Foreground="{StaticResource Accent.HiBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="拖动绑定游戏窗口" FontSize="12.5" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Button Content="扫描游戏窗口" Style="{StaticResource GhostButton}" Height="34"
                                        Command="{Binding ScanGameWindowsCommand}" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding WindowScanStatus}" Style="{StaticResource Caption}"
                                           TextAlignment="Center" Margin="0,0,0,12" />

                                <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10"
                                        Visibility="{Binding BindingPanel.HasBinding, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="角色记忆" Style="{StaticResource H2}" FontSize="13" Margin="0,0,0,7" />
                                        <TextBlock Text="{Binding ActiveRoleTitle}" FontSize="12.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding AutoSaveStatusText}" Style="{StaticResource Caption}"
                                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="12"
                                        Visibility="{Binding BindingPanel.HasBinding, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="当前任务" Style="{StaticResource H2}" FontSize="13" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Fill="{Binding RunState, Converter={StaticResource RunStateBrush}}" />
                                                <TextBlock Text="{Binding RunState, Converter={StaticResource RunStateText}}"
                                                           Style="{StaticResource Caption}" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <ComboBox ItemsSource="{Binding RunModes}"
                                                  SelectedItem="{Binding SelectedRunMode, Mode=TwoWay}"
                                                  DisplayMemberPath="RunLabel"
                                                  Height="34" />

                                        <Border Margin="0,8,0,0" CornerRadius="8" Padding="9,7"
                                                Background="{Binding InputYieldActive, Converter={StaticResource InputYieldBg}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="7" Height="7" VerticalAlignment="Top" Margin="0,3,0,0"
                                                         Fill="{Binding InputYieldActive, Converter={StaticResource InputYieldBrush}}" />
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding InputYieldStatusText}" FontSize="11.5" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Margin="0,8,0,0" CornerRadius="8" Padding="9,7"
                                                Background="#151D2939" BorderBrush="Transparent" BorderThickness="0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding MainlineReadinessTitle}" FontSize="11.5" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding MainlineReadinessSummary}"
                                                           Style="{StaticResource Caption}"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="34"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Button Content="{Binding StartButtonText}"
                                                AutomationProperties.Name="{Binding StartButtonText}"
                                                Style="{StaticResource PrimaryButton}" Height="39"
                                                Command="{Binding StartCommand}" Margin="0,10,0,0" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="7" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Content="暂停" Style="{StaticResource GhostButton}" Height="32"
                                                    Command="{Binding PauseCommand}" />
                                            <Button Grid.Column="2" Content="停止当前" Style="{StaticResource GhostButton}" Height="32"
                                                    Command="{Binding StopCommand}" />
                                        </Grid>
                                        <Button Content="全部停止" Style="{StaticResource GhostButton}" Height="30"
                                                Command="{Binding StopAllCommand}" Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="2" Margin="14,6,14,14">
                            <Button x:Name="AccountMenuButton"
                                    Style="{StaticResource FlatShellButton}"
                                    Command="{Binding ToggleAccountMenuCommand}"
                                    AutomationProperties.Name="账户菜单">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="30" Height="30" CornerRadius="15"
                                            Background="{StaticResource Bg.ElevatedBrush}">
                                        <Grid>
                                            <TextBlock Text="&#xE77B;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <Ellipse Width="7" Height="7"
                                                     HorizontalAlignment="Right"
                                                     VerticalAlignment="Bottom"
                                                     Stroke="{StaticResource Bg.SidebarBrush}"
                                                     StrokeThickness="2">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource Text.MutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUserLoggedIn}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding UserDisplayName}"
                                                   FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding UserStatusText}"
                                                   Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="&#xE70D;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="10"
                                               Foreground="{StaticResource Text.MutedBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <Popup IsOpen="{Binding IsAccountMenuOpen, Mode=TwoWay}"
                                   PlacementTarget="{Binding ElementName=AccountMenuButton}"
                                   Placement="Top"
                                   VerticalOffset="-8"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border Style="{StaticResource ElevatedCard}" Width="270" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="账户" Style="{StaticResource H2}" Margin="2,0,2,10" />

                                        <Grid Margin="2,0,2,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{StaticResource Text.MutedBrush}" />
                                            <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                                <TextBlock Text="{Binding UserDisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding UserStatusText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <Button Content="登录"
                                                Style="{StaticResource GhostButton}"
                                                Height="32"
                                                IsEnabled="{Binding IsUserLoginAvailable}"
                                                Command="{Binding BeginUserLoginCommand}"
                                                ToolTip="登录服务待接入" />
                                        <Button Content="账户与权益"
                                                Style="{StaticResource GhostButton}"
                                                Height="32" Margin="0,7,0,0"
                                                IsEnabled="False" />
                                        <Button Content="设置"
                                                Style="{StaticResource GhostButton}"
                                                Height="32" Margin="0,7,0,0"
                                                Command="{Binding OpenRoleSettingsCommand}" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Background="{StaticResource Bg.WindowBrush}"
                        BorderBrush="Transparent" BorderThickness="0"
                        CornerRadius="16,0,0,0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="64" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="0">
                        <Grid Margin="22,0,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ListBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                                     Background="Transparent" BorderThickness="0"
                                     VerticalAlignment="Center"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource PrimaryNavItem}">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Title}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Button Grid.Column="1" Style="{StaticResource FlatShellButton}" Height="32" Width="36" Padding="0"
                                    FontFamily="Segoe MDL2 Assets" FontSize="13" Content="&#xE713;"
                                    Command="{Binding OpenRoleSettingsCommand}" ToolTip="角色设置" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="0">
                        <StackPanel Margin="26,16,22,13">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding ActiveRoleTitle}" Style="{StaticResource H1}" />
                                </StackPanel>
                            </Grid>

                            <ListBox ItemsSource="{Binding CurrentModeTags}" SelectedItem="{Binding SelectedMode}"
                                     Background="Transparent" BorderThickness="0" Margin="0,14,0,0"
                                     Visibility="{Binding HasModeTags, Converter={StaticResource BoolToVis}}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource SecondaryNavItem}">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Title}" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" />
                                            <Ellipse Width="6" Height="6" Margin="7,0,0,0" VerticalAlignment="Center"
                                                     Fill="#D99A45"
                                                     ToolTip="{Binding AvailabilityText}"
                                                     Visibility="{Binding ShowPendingBadge, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" ClipToBounds="True">
                            <Image Source="Assets/Brand/tlbb-agent-poster.png"
                                   Stretch="UniformToFill"
                                   Opacity="0.55"
                                   IsHitTestVisible="False"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <Rectangle Fill="{StaticResource BrandPosterOverlayBrush}"
                                       IsHitTestVisible="False" />
                            <ContentControl Content="{Binding CurrentDetail}" />
                    </Grid>
                    <views:LogPanel Grid.Row="3" Margin="10,0,10,10" DataContext="{Binding LogPanel}" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.RowSpan="2" Panel.ZIndex="300"
                  Background="#B800050D"
                  Visibility="{Binding IsRoleEnrollmentRequired, Converter={StaticResource BoolToVis}}">
                <Border Width="520" MaxHeight="650" Padding="26" CornerRadius="14"
                        Background="{StaticResource Bg.SurfaceBrush}"
                        BorderBrush="{StaticResource StrokeStrongBrush}" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="首次绑定" Foreground="{StaticResource AccentBrush}"
                                   FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding RoleEnrollmentTitle}" Style="{StaticResource H1}" Margin="0,7,0,0" />
                        <TextBlock Text="{Binding RoleEnrollmentMessage}" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" Margin="0,7,0,18" />

                        <ItemsControl ItemsSource="{Binding RoleIdentityCandidates}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GhostButton}" Height="42" Margin="0,0,0,7"
                                            Command="{Binding DataContext.UseRoleCandidateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding ScoreText}" Style="{StaticResource Caption}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="角色名称" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding RoleEnrollmentName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Height="38" MaxLength="20" />
                        <TextBlock Text="名称只用于本机识别；配置将自动跟随该角色。"
                                   Style="{StaticResource Caption}" Margin="0,7,0,0" />

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Content="重新识别" Style="{StaticResource GhostButton}" Width="108" Height="36"
                                    Command="{Binding RetryRoleIdentityCommand}" />
                            <TextBlock Grid.Column="1" Text="正在读取角色画面…" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding IsRoleIdentityBusy, Converter={StaticResource BoolToVis}}" />
                            <Button Grid.Column="2" Content="确认并继续" Style="{StaticResource PrimaryButton}"
                                    Width="120" Height="36" Command="{Binding ConfirmRoleEnrollmentCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
